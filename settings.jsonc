22/%3E%3C/g%3E%3C/g%3E%3C/g%3E%3C/g%3E%3C/g%3E%3C/g%3E%3C/svg%3E') center / contain no-repeat",
    },
    // text under Milo: same mono + orange as his glyphs, tighter to his chin, terminal cursor (reuses Claude's blink_07S1Yg keyframe; cursor just stops blinking if that hash changes)
    "[class^=\"container_\"]:has(> [class^=\"messageContainer_\"])": { "gap": "10px !important" },
    "[class^=\"container_\"] > [class^=\"messageContainer_\"]": { "max-width": "236px !important" },
    "[class^=\"container_\"] > [class^=\"messageContainer_\"] > [class^=\"message_\"]": {
      "margin-top": "0 !important",
      "font-family": "'Geist Mono', 'JetBrains Mono', Menlo, monospace !important",
      "font-size": "11.5px !important",
      "line-height": "1.65 !important",
      "letter-spacing": "0.01em",
      "color": "#e8e1d6 !important",
      "text-wrap": "balance",
    },
    "[class^=\"container_\"] > [class^=\"messageContainer_\"] > [class^=\"message_\"]::after": {
      "content": "''",
      "display": "inline-block",
      "width": "0.55em",
      "height": "1.05em",
      "margin-left": "3px",
      "vertical-align": "-0.18em",
      "background": "#D97757",
      "border-radius": "1px",
      "animation": "blink_07S1Yg 1.1s steps(1, end) infinite",
    },
    "[class^=\"container_\"] > [class^=\"messageContainer_\"] [class^=\"key_\"]": {
      "font-family": "'Geist Mono', 'JetBrains Mono', Menlo, monospace !important",
      "color": "#D97757 !important",
    },
    "[class^=\"container_\"] > [class^=\"messageContainer_\"] [class^=\"key_\"]::before": {
      "border-color": "#d9775780 !important",
    },
    "strong, b": { "color": "#f2ede6", "font-weight": "600" },
    "h1, h2, h3, h4": { "color": "#7dd3a0" },
    "a, a code": { "color": "#6ea8fe !important" },
    "a:hover": { "color": "#a5c8ff !important" },
    ":not(pre) > code": {
      "color": "#d4bf6a",
      "background": "#d4bf6a1a",
      "font-weight": "600",
    },
    // hex swatch: data-hx is set by the script patched into Claude's webview
    "code[data-hx]::before": {
      "content": "''",
      "display": "inline-block",
      "width": "0.8em",
      "height": "0.8em",
      "margin-right": "5px",
      "vertical-align": "-1px",
      "border-radius": "3px",
      "background": "var(--hx)",
      "box-shadow": "inset 0 0 0 1px #ffffff2e",
    },
    // chat layout: your avatar + tinted bubble; Claude avatar on the newest block of each reply
    "[class*=\"userMessageContainer_\"]:not([class*=\"userMessageContainer_\"] [class*=\"userMessageContainer_\"])": {
      "padding-left": "30px !important",
      "margin-top": "14px",
    },
    "[class*=\"userMessageContainer_\"] > [class*=\"userMessageContainer_\"]": {
      "position": "relative",
      "overflow": "visible",
    },
    "[class*=\"userMessageContainer_\"] > [class*=\"userMessageContainer_\"]:not([class*=\"userMessageContainer_\"] ~ [class*=\"userMessageContainer_\"])::before": {
      "content": "'{{INITIALS}}'",
      "position": "absolute",
      "left": "-29px",
      "top": "0",
      "width": "22px",
      "height": "22px",
      "border-radius": "50%",
      "background": "#2e8b57",
      "color": "#ffffff",
      "font": "600 9px/22px Geist, sans-serif",
      "text-align": "center",
      "letter-spacing": "0.02em",
      "z-index": "1",
    },
    "[class^=\"userMessage_\"], [class*=\" userMessage_\"]": {
      "background": "color-mix(in srgb, #2e8b57 10%, var(--app-input-background)) !important",
      "border-color": "#2e8b5766 !important",
    },
    "[class*=\"timelineMessage_\"]:not(:has(+ [class*=\"timelineMessage_\"]))::before": {
      "width": "22px !important",
      "height": "22px !important",
      "left": "1px !important",
      "top": "calc(var(--message-padding-top, 8px) - 1px) !important",
      "background": "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%2212%22%20fill%3D%22%23d97757%22%2F%3E%3Cg%20stroke%3D%22%23fff%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%3E%3Cline%20x1%3D%2212.00%22%20y1%3D%229.80%22%20x2%3D%2212.00%22%20y2%3D%224.80%22%2F%3E%3Cline%20x1%3D%2213.29%22%20y1%3D%2210.22%22%20x2%3D%2215.29%22%20y2%3D%227.47%22%2F%3E%3Cline%20x1%3D%2214.09%22%20y1%3D%2211.32%22%20x2%3D%2218.85%22%20y2%3D%229.78%22%2F%3E%3Cline%20x1%3D%2214.09%22%20y1%3D%2212.68%22%20x2%3D%2217.33%22%20y2%3D%2213.73%22%2F%3E%3Cline%20x1%3D%2213.29%22%20y1%3D%2213.78%22%20x2%3D%2216.23%22%20y2%3D%2217.82%22%2F%3E%3Cline%20x1%3D%2212.00%22%20y1%3D%2214.20%22%20x2%3D%2212.00%22%20y2%3D%2217.60%22%2F%3E%3Cline%20x1%3D%2210.71%22%20y1%3D%2213.78%22%20x2%3D%227.77%22%20y2%3D%2217.82%22%2F%3E%3Cline%20x1%3D%229.91%22%20y1%3D%2212.68%22%20x2%3D%226.67%22%20y2%3D%2213.73%22%2F%3E%3Cline%20x1%3D%229.91%22%20y1%3D%2211.32%22%20x2%3D%225.15%22%20y2%3D%229.78%22%2F%3E%3Cline%20x1%3D%2210.71%22%20y1%3D%2210.22%22%20x2%3D%228.71%22%20y2%3D%227.47%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E') center / cover no-repeat !important",
    },
    "[class*=\"sendButton_\"][data-permission-mode=auto]": {
      "background-color": "#2e8b57 !important",
    },
    "[class*=\"inputContainer_\"][data-permission-mode=auto]:focus-within": {
      "--focus-ring-color": "#2e8b57 !important",
    },
    "[class^=\"container_\"][data-permission-mode=auto] [class^=\"icon_\"]": {
      "color": "#5fc98d !important",
    },
    // chat webview reads sideBar.background; keep chat on the original Theme Mix sidebar color while the side bar itself goes darker
    "html:root:has([class*=\"inputContainer_\"])": {
      "--app-primary-background": "#21252c !important",
      "--app-header-background": "#21252c !important",
    },
    // usage bars: <80% default, 80-89% yellow, 90%+ red (keyed off the fill's inline width)
    "[class*=\"usageFill_\"][style*=\"width: 8\"]:not([style*=\"width: 8%\"]):not([style*=\"width: 8.\"])": {
      "background-color": "#e5c07b !important",
    },
    "[class*=\"usageFill_\"][style*=\"width: 9\"]:not([style*=\"width: 9%\"]):not([style*=\"width: 9.\"]), [class*=\"usageFill_\"][style*=\"width: 100%\"]": {
      "background-color": "#e06c75 !important",
    },
    "[class*=\"usageBarContainer_\"]:has([class*=\"usageFill_\"][style*=\"width: 8\"]:not([style*=\"width: 8%\"]):not([style*=\"width: 8.\"])) [class*=\"usagePercent_\"]": {
      "color": "#e5c07b !important",
    },
    "[class*=\"usageBarContainer_\"]:has([class*=\"usageFill_\"][style*=\"width: 9\"]:not([style*=\"width: 9%\"]):not([style*=\"width: 9.\"]), [class*=\"usageFill_\"][style*=\"width: 100%\"]) [class*=\"usagePercent_\"]": {
      "color": "#e06c75 !important",
    },
    // panel redesign (sessions sidebar): account card, primary New session, tinted Local/Web tab, quieter toolbar, cleaner list
    "[class*=\"root_\"]:has(> [class*=\"sectionHeader_\"])": { "padding": "8px 16px 16px !important" },
    "[class*=\"sectionHeader_\"]": { "border-top": "none !important", "min-height": "28px", "margin-bottom": "8px", "flex-wrap": "nowrap !important" },
    "[class*=\"sectionHeader_\"]:not(:first-child)": { "margin-top": "20px" },
    "[class*=\"sectionHeader_\"] [class*=\"sectionToggle_\"]": { "padding": "0 4px 0 0 !important", "gap": "4px !important", "height": "28px !important" },
    "[class*=\"sectionHeader_\"] [class*=\"sectionLabel_\"]": { "font-size": "11px !important", "font-weight": "500 !important", "letter-spacing": "0.06em !important", "color": "#8b919c !important" },
    "[class*=\"sectionHeader_\"]:hover [class*=\"sectionLabel_\"]": { "color": "#c8ccd4 !important" },
    "[class*=\"sectionHeader_\"] [class*=\"sectionLink_\"]": { "font-size": "0 !important", "width": "28px", "height": "28px", "min-height": "28px !important", "margin-left": "auto !important", "padding": "0 !important", "display": "grid", "place-items": "center", "border-radius": "6px", "opacity": "1 !important", "text-decoration": "none !important", "color": "#8b919c !important", "transition": "background 120ms, color 120ms" },
    "[class*=\"sectionHeader_\"] [class*=\"sectionLink_\"]::before": { "content": "''", "width": "16px", "height": "16px", "background": "currentColor", "-webkit-mask": "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M16.0037%209.41421L7.39712%2018.0208L5.98291%2016.6066L14.5895%208H7.00373V6H18.0037V17H16.0037V9.41421Z%22%2F%3E%3C%2Fsvg%3E') center / contain no-repeat", "mask": "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M16.0037%209.41421L7.39712%2018.0208L5.98291%2016.6066L14.5895%208H7.00373V6H18.0037V17H16.0037V9.41421Z%22%2F%3E%3C%2Fsvg%3E') center / contain no-repeat" },
    "[class*=\"sectionHeader_\"] [class*=\"sectionLink_\"]:hover": { "background": "#1f2228", "color": "#eceef2 !important" },
    "[class*=\"accountUsageBody_\"]": { "background": "#1b1e23", "border": "1px solid #252930", "border-radius": "10px", "padding": "0 !important", "gap": "0 !important" },
    "[class*=\"accountUsageBody_\"] > [class*=\"section_\"]": { "padding": "12px", "gap": "10px !important" },
    "[class*=\"accountUsageBody_\"] > [class*=\"section_\"] + [class*=\"section_\"]": { "border-top": "1px solid #252930" },
    "[class*=\"accountUsageBody_\"] [class*=\"sectionTitle_\"]": { "display": "none !important" },
    "[class*=\"accountUsageBody_\"] [class*=\"section_\"]:has(> [class*=\"accountInfo_\"]) [class*=\"accountRow_\"]": { "justify-content": "flex-start !important", "gap": "10px", "padding": "0 !important", "flex-wrap": "nowrap !important" },
    "[class*=\"accountUsageBody_\"] [class*=\"section_\"]:has(> [class*=\"accountInfo_\"]) [class*=\"accountRow_\"]::before": { "content": "'{{INITIALS}}'", "flex": "none", "width": "28px", "height": "28px", "border-radius": "50%", "background": "#21252c", "box-shadow": "inset 0 0 0 1px #323742", "color": "#eceef2", "font": "600 11px/28px Geist, sans-serif", "text-align": "center", "letter-spacing": "0.02em" },
    "[class*=\"accountUsageBody_\"] [class*=\"section_\"]:has(> [class*=\"accountInfo_\"]) [class*=\"accountLabel_\"]": { "display": "none !important" },
    "[class*=\"accountUsageBody_\"] [class*=\"section_\"]:has(> [class*=\"accountInfo_\"]) [class*=\"accountValue_\"]": { "min-width": "0", "flex": "0 1 auto", "color": "#eceef2 !important", "font-weight": "500", "white-space": "nowrap", "overflow": "hidden", "text-overflow": "ellipsis", "overflow-wrap": "normal !important" },
    "[class*=\"accountUsageBody_\"] [class*=\"usageBars_\"]": { "gap": "14px !important" },
    "[class*=\"accountUsageBody_\"] [class*=\"usageBarContainer_\"]": { "gap": "6px !important" },
    "[class*=\"accountUsageBody_\"] [class*=\"usageLabel_\"]": { "color": "#c8ccd4 !important", "font-weight": "500" },
    "[class*=\"accountUsageBody_\"] [class*=\"usagePercent_\"]": { "font-family": "'Geist Mono', 'JetBrains Mono', Menlo, monospace !important", "font-size": "12px !important", "color": "#eceef2" },
    "[class*=\"accountUsageBody_\"] [class*=\"usageTrack_\"]": { "height": "4px !important", "border-radius": "99px !important", "background": "#21252c !important" },
    "[class*=\"accountUsageBody_\"] [class*=\"usageFill_\"]": { "border-radius": "99px !important" },
    "[class*=\"accountUsageBody_\"] [class*=\"resetText_\"]": { "font-size": "11px !important", "color": "#5f6571 !important", "opacity": "1 !important" },
    "[class*=\"sessionsBody_\"]": { "gap": "12px" },
    "[class*=\"sessionsBody_\"] [class*=\"headerRow_\"]": { "border-bottom": "none !important", "gap": "6px" },
    "[class*=\"sessionsBody_\"] [class*=\"newSessionButton_\"]": { "height": "34px", "padding": "0 12px !important", "justify-content": "center", "background": "#2e8b57 !important", "color": "#ffffff !important", "border-radius": "8px !important", "font-weight": "500 !important", "box-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 1px 2px rgba(0, 0, 0, 0.4)", "transition": "background 120ms" },
    "[class*=\"sessionsBody_\"] [class*=\"newSessionButton_\"]:hover": { "background": "#34a065 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"newSessionButton_\"]:active": { "background": "#277a4c !important" },
    "[class*=\"sessionsBody_\"] [class*=\"createWorktreeButton_\"]": { "width": "34px", "height": "34px", "padding": "0 !important", "border-radius": "8px", "border": "1px solid #252930 !important", "background": "#1b1e23 !important" },
    "[class*=\"sessionsBody_\"] > [class*=\"root_\"]": { "padding": "0 !important", "gap": "12px" },
    "[class*=\"sessionsBody_\"] [class*=\"segmented_\"]": { "background": "#1b1e23 !important", "border": "1px solid #252930", "border-radius": "8px !important", "padding": "2px !important", "gap": "2px !important" },
    "[class*=\"sessionsBody_\"] [class*=\"segmented_\"] > [class*=\"tab_\"]": { "height": "28px", "padding": "0 12px !important", "border-radius": "6px !important", "border": "1px solid transparent !important", "font-size": "13px !important", "font-weight": "500", "color": "#8b919c !important", "transition": "background 120ms, color 120ms" },
    "[class*=\"sessionsBody_\"] [class*=\"segmented_\"] > [class*=\"tab_\"]:hover": { "background": "#1f2228 !important", "color": "#c8ccd4 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"segmented_\"] > [class*=\"tabActive_\"], [class*=\"sessionsBody_\"] [class*=\"segmented_\"] > [class*=\"tabActive_\"]:hover": { "background": "rgba(46, 139, 87, 0.16) !important", "color": "#5fc98d !important", "border-color": "rgba(46, 139, 87, 0.32) !important", "box-shadow": "none !important" },
    // search: always open (patched in webview/index.js), full width; filter + Active toggle removed (count moved to the Session manager badge)
    "[class*=\"sessionsBody_\"] [class*=\"searchRow_\"]": { "padding": "0 !important", "gap": "0 !important", "flex-wrap": "nowrap !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchRowActions_\"]": { "display": "none !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchRowTail_\"]": { "margin-left": "auto", "gap": "6px" },
    "[class*=\"sessionsBody_\"] [class*=\"searchRowTail_\"] > button[title=\"New group\"]": { "display": "none !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchRow_\"] [class*=\"newGroupButton_\"]": { "height": "30px", "margin-left": "0 !important", "padding": "0 8px !important", "border": "1px solid #252930 !important", "background": "#1b1e23 !important", "border-radius": "8px !important", "color": "#8b919c !important", "font-size": "12px !important", "font-weight": "500", "transition": "background 120ms, color 120ms" },
    "[class*=\"sessionsBody_\"] [class*=\"searchRow_\"] [class*=\"newGroupButton_\"]:hover, [class*=\"sessionsBody_\"] [class*=\"searchRow_\"] [class*=\"newGroupButton_\"]:focus-visible": { "background": "#1f2228 !important", "color": "#eceef2 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchRow_\"] [class*=\"searchToggleButton_\"]": { "width": "30px", "padding": "0 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchRow_\"] [class*=\"filterToggleOn_\"]": { "background": "rgba(46, 139, 87, 0.16) !important", "color": "#5fc98d !important", "border-color": "rgba(46, 139, 87, 0.32) !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchInput_\"]": { "height": "26px !important", "min-height": "0 !important", "padding": "0 24px 0 26px !important", "border-radius": "6px !important", "background": "#1b1e23 !important", "border": "1px solid #252930 !important", "color": "#eceef2 !important", "font-size": "12px !important", "line-height": "24px !important", "transition": "border-color 120ms, box-shadow 120ms" },
    "[class*=\"sessionsBody_\"] [class*=\"searchInput_\"]:focus": { "border-color": "#2e8b57 !important", "box-shadow": "0 0 0 2px rgba(46, 139, 87, 0.18) !important", "outline": "none !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionsList_\"]": { "padding": "0 !important", "gap": "2px !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionsList_\"]:not(:has([class*=\"groupHeader_\"]))::before": { "content": "'Recent'", "display": "flex", "align-items": "center", "height": "24px", "padding": "0 8px", "font-size": "11px", "font-weight": "500", "letter-spacing": "0.04em", "text-transform": "uppercase", "color": "#5f6571" },
    "[class*=\"sessionsBody_\"] [class*=\"groupName_\"]": { "color": "#5f6571 !important", "font-size": "11px !important", "font-weight": "500 !important", "letter-spacing": "0.04em", "text-transform": "uppercase" },
    "[class*=\"sessionsBody_\"] [class*=\"groupCount_\"]": { "background": "transparent !important", "color": "#5f6571 !important", "font-family": "'Geist Mono', 'JetBrains Mono', Menlo, monospace", "padding": "0 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"]": { "height": "32px !important", "padding": "0 8px !important", "gap": "10px !important", "border-radius": "6px !important", "color": "#c8ccd4", "transition": "background 120ms" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"]:hover": { "background": "#1f2228 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"][class*=\"active_\"]": { "background": "#21252c !important", "color": "#eceef2 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"] [class*=\"sessionName_\"]": { "color": "#c8ccd4 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"]:hover [class*=\"sessionName_\"], [class*=\"sessionsBody_\"] [class*=\"sessionItem_\"][class*=\"active_\"] [class*=\"sessionName_\"]": { "color": "#eceef2 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"][class*=\"active_\"] [class*=\"sessionName_\"]": { "font-weight": "500 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"]:has(> [class*=\"sessionName_\"]:first-child)::before": { "content": "''", "flex": "none", "width": "15px", "height": "15px", "margin": "0 0.5px", "background": "#5f6571", "-webkit-mask": "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M7.29117%2020.8242L2%2022L3.17581%2016.7088C2.42544%2015.3056%202%2013.7025%202%2012C2%206.47715%206.47715%202%2012%202C17.5228%202%2022%206.47715%2022%2012C22%2017.5228%2017.5228%2022%2012%2022C10.2975%2022%208.6944%2021.5746%207.29117%2020.8242ZM7.58075%2018.711L8.23428%2019.0605C9.38248%2019.6745%2010.6655%2020%2012%2020C16.4183%2020%2020%2016.4183%2020%2012C20%207.58172%2016.4183%204%2012%204C7.58172%204%204%207.58172%204%2012C4%2013.3345%204.32549%2014.6175%204.93949%2015.7657L5.28896%2016.4192L4.63416%2019.3658L7.58075%2018.711Z%22%2F%3E%3C%2Fsvg%3E') center / contain no-repeat", "mask": "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M7.29117%2020.8242L2%2022L3.17581%2016.7088C2.42544%2015.3056%202%2013.7025%202%2012C2%206.47715%206.47715%202%2012%202C17.5228%202%2022%206.47715%2022%2012C22%2017.5228%2017.5228%2022%2012%2022C10.2975%2022%208.6944%2021.5746%207.29117%2020.8242ZM7.58075%2018.711L8.23428%2019.0605C9.38248%2019.6745%2010.6655%2020%2012%2020C16.4183%2020%2020%2016.4183%2020%2012C20%207.58172%2016.4183%204%2012%204C7.58172%204%204%207.58172%204%2012C4%2013.3345%204.32549%2014.6175%204.93949%2015.7657L5.28896%2016.4192L4.63416%2019.3658L7.58075%2018.711Z%22%2F%3E%3C%2Fsvg%3E') center / contain no-repeat" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"][class*=\"active_\"]:has(> [class*=\"sessionName_\"]:first-child)::before": { "background": "#8b919c" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"] > :first-child:not([class*=\"sessionName_\"]):not([class*=\"statusDot\"])": { "min-width": "16px", "display": "flex", "justify-content": "center" },
    // status dot (running / waiting / unread): keep 8px circle, 4px side margins hold the 16px icon column
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"] [class*=\"statusDot\"]": { "width": "8px !important", "height": "8px !important", "min-width": "8px !important", "flex": "none !important", "margin": "0 4px !important", "border-radius": "50% !important" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"] [class*=\"sessionTime_\"]": { "font-family": "'Geist Mono', 'JetBrains Mono', Menlo, monospace", "font-size": "11px !important", "color": "#5f6571", "opacity": "1 !important", "font-variant-numeric": "tabular-nums" },
    "[class*=\"sessionsBody_\"] [class*=\"sessionItem_\"][class*=\"selected_\"]": { "outline-color": "rgba(46, 139, 87, 0.32) !important", "background": "rgba(46, 139, 87, 0.16) !important" },
    // switch account button next to the email
    ".ccSwitchAcct": { "flex": "none", "display": "inline-flex", "align-items": "center", "justify-content": "center", "width": "24px", "height": "24px", "margin-left": "auto", "padding": "0", "border": "1px solid transparent", "border-radius": "6px", "background": "transparent", "color": "#8b919c", "cursor": "pointer", "transition": "background 120ms, color 120ms" },
    ".ccSwitchAcct:hover": { "background": "#1f2228", "color": "#eceef2" },
    ".ccSwitchAcct:focus-visible": { "outline": "none", "border-color": "#2e8b57" },
    ".ccSwitchAcct[data-armed]": { "background": "rgba(239, 68, 68, 0.14)", "border-color": "rgba(239, 68, 68, 0.32)", "color": "#f87171" },
    // search box fills the row; icon and placeholder readable
    "[class*=\"sessionsBody_\"] [class*=\"searchBox_\"]": { "flex": "1 1 100% !important", "min-width": "0 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchIcon_\"]": { "width": "12px !important", "height": "12px !important", "left": "8px !important", "color": "#8b919c !important", "opacity": "1 !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchInput_\"]::placeholder": { "color": "#8b919c !important", "opacity": "1" },
    "[class*=\"sessionsBody_\"] [class*=\"searchRowTail_\"]:not(:has(> :not([title=\"New group\"])))": { "display": "none !important" },
    // Session manager: active-session count badge (value from --cc-active, set by the webview patch; hidden at 0)
    "[class*=\"sectionHeader_\"]:has(+ [class*=\"sessionsBody_\"]) [class*=\"sectionLabel_\"]": { "display": "inline-flex !important", "align-items": "center", "gap": "8px" },
    "[class*=\"sectionHeader_\"]:has(+ [class*=\"sessionsBody_\"]) [class*=\"sectionLabel_\"]::after": { "content": "var(--cc-active, '')", "display": "inline-flex", "align-items": "center", "justify-content": "center", "height": "18px", "min-width": "18px", "padding": "0 6px", "box-sizing": "border-box", "border-radius": "99px", "background": "rgba(46, 139, 87, 0.16)", "border": "1px solid rgba(46, 139, 87, 0.32)", "color": "#5fc98d", "font-family": "'Geist Mono', 'JetBrains Mono', Menlo, monospace", "font-size": "11px", "font-weight": "500", "letter-spacing": "0", "text-transform": "none", "line-height": "1" },
    ":root[data-cc-active=\"0\"] [class*=\"sectionHeader_\"]:has(+ [class*=\"sessionsBody_\"]) [class*=\"sectionLabel_\"]::after, :root:not([data-cc-active]) [class*=\"sectionHeader_\"]:has(+ [class*=\"sessionsBody_\"]) [class*=\"sectionLabel_\"]::after": { "display": "none" },
    // search: clear "x" only once there is text; smaller hit target
    "[class*=\"sessionsBody_\"] [class*=\"searchInput_\"]:placeholder-shown + [class*=\"searchClearButton_\"]": { "display": "none !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchClearButton_\"]": { "width": "18px !important", "height": "18px !important", "right": "4px !important" },
    "[class*=\"sessionsBody_\"] [class*=\"searchClearIcon_\"]": { "width": "12px !important", "height": "12px !important" },
    // chat header usage chip (5h session + 7d weekly): green <80%, yellow 80-89%, red 90%+; sits right after the title
    "[class*=\"header_\"] > [class*=\"titleGroup_\"]": { "order": "-1" },
    ".ccUsage": { "display": "inline-flex", "align-items": "center", "gap": "10px", "flex": "none", "margin": "0 8px", "font-family": "'Geist Mono', 'JetBrains Mono', Menlo, monospace", "font-size": "11px", "line-height": "1", "color": "#8b919c", "white-space": "nowrap" },
    ".ccUsage:empty": { "display": "none" },
    ".ccU": { "display": "inline-flex", "align-items": "center", "gap": "5px" },
    ".ccU b": { "font-weight": "500", "color": "#5f6571" },
    ".ccU i": { "display": "block", "width": "28px", "height": "4px", "border-radius": "99px", "background": "#21252c", "overflow": "hidden" },
    ".ccU s": { "display": "block", "height": "100%", "border-radius": "99px", "background": "#2e8b57", "text-decoration": "none" },
    ".ccU em": { "font-style": "normal", "color": "#c8ccd4", "font-variant-numeric": "tabular-nums" },
    ".ccU.warn s": { "background": "#e5c07b" },
    ".ccU.warn em": { "color": "#e5c07b" },
    ".ccU.crit s": { "background": "#e06c75" },
    ".ccU.crit em": { "color": "#e06c75" },
  },
  "workbench.colorTheme": "Theme Mix",
  "workbench.navigationControl.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "window.commandCenter": false,
  "workbench.statusBar.visible": true, // on for Claude usage only (other items hidden via custom-ui-style.stylesheet)
}
