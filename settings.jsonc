    "[data-mk-uacts]": {
      "position": "absolute !important",
      "top": "auto !important",
      "right": "calc(var(--mk-ub-r, 0px) + 8px) !important",
      "bottom": "calc(var(--mk-ub-b, 0px) + 8px) !important",
      "z-index": "1 !important",
      "display": "flex",
      "align-items": "center",
      "gap": "0",
      "padding": "2px",
      "border-radius": "var(--mk-r-9)",
      "background": "color-mix(in srgb, #fff 4%, var(--app-primary-background, var(--mk-card)))",
      "box-shadow": "inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 6px 16px -6px rgba(0, 0, 0, 0.55)",
      "opacity": "0",
      "transition": "opacity 120ms cubic-bezier(.4, 0, .2, 1)"
    },
    "[data-mk-uacts] > button": {
      "width": "23px",
      "height": "24px",
      "min-width": "0",
      "padding": "0",
      "margin": "0",
      "display": "grid",
      "place-items": "center",
      "border": "0 !important",
      "border-radius": "var(--mk-r-7) !important",
      "background": "transparent !important",
      "box-shadow": "none",
      "opacity": "1 !important",
      "transform": "none !important",
      "color": "var(--mk-fg-12)",
      "cursor": "pointer",
      "transition": "background-color 120ms cubic-bezier(.4, 0, .2, 1), color 120ms cubic-bezier(.4, 0, .2, 1)"
    },
    "[data-mk-uacts]:hover > button, [class*=\"userMessageContainer_\"]:hover > [data-mk-uacts] > button": {
      "color": "var(--mk-fg-10)"
    },
    "[data-mk-uacts] > button:is(:hover, [aria-expanded=\"true\"])": {
      "background": "rgba(255, 255, 255, 0.07) !important",
      "color": "var(--mk-fg)"
    },
    "[data-mk-uacts] > button:focus-visible": {
      "outline": "none",
      "box-shadow": "0 0 0 2px color-mix(in srgb, var(--mk-accent-soft) 50%, transparent)"
    },
    "[data-mk-uacts] > button[title=\"Message actions\"] > svg": {
      "display": "none"
    },
    "[data-mk-uacts] > button::before": {
      "content": "''",
      "width": "15px",
      "height": "15px",
      "background": "currentColor"
    },
    "[data-mk-uacts] > button[title=\"Message actions\"]::before": {
      "-webkit-mask": "url(\"data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22currentColor%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M4.5%2010.5C3.675%2010.5%203%2011.175%203%2012C3%2012.825%203.675%2013.5%204.5%2013.5C5.325%2013.5%206%2012.825%206%2012C6%2011.175%205.325%2010.5%204.5%2010.5ZM19.5%2010.5C18.675%2010.5%2018%2011.175%2018%2012C18%2012.825%2018.675%2013.5%2019.5%2013.5C20.325%2013.5%2021%2012.825%2021%2012C21%2011.175%2020.325%2010.5%2019.5%2010.5ZM12%2010.5C11.175%2010.5%2010.5%2011.175%2010.5%2012C10.5%2012.825%2011.175%2013.5%2012%2013.5C12.825%2013.5%2013.5%2012.825%2013.5%2012C13.5%2011.175%2012.825%2010.5%2012%2010.5Z%22%2F%3E%3C%2Fsvg%3E\") center / contain no-repeat",
