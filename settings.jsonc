// Milo Kit: VS Code settings fragment. Generated by scripts/sync-from-live.js. Do not edit by hand.
// install.sh merges this into the user's settings.json. {{INITIALS}} becomes the user's avatar initials.
{
  // ── Theme stack ───────────────────────────────────────
  "claudeCode.preferredLocation": "panel",
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "remix-product-icons",
  "workbench.fontAliasing": "antialiased",
  "workbench.colorCustomizations": {
    // Theme Mix: side bars much darker than chat/editor (#282c34) for contrast
    "[Theme Mix]": {
      "sideBar.background": "#15171b",
      "sideBar.border": "#15171b",
      "sideBarSectionHeader.background": "#15171b",
      "sideBarSectionHeader.border": "#15171b",
      "auxiliaryBar.background": "#15171b",
      "auxiliaryBar.border": "#15171b",
      "activityBar.background": "#15171b",
      // tabs: mid strip (between side menu #15171b and chat #21252c), active tab = chat bg so it joins the chat below
      "titleBar.activeBackground": "#1b1e23",
      "titleBar.inactiveBackground": "#1b1e23",
      "titleBar.border": "#1b1e23",
      "editorGroupHeader.tabsBackground": "#1b1e23",
      "editorGroupHeader.tabsBorder": "#1b1e23",
      "editorGroupHeader.border": "#1b1e23",
      "tab.border": "#1b1e23",
      "tab.activeBackground": "#21252c",
      "tab.unfocusedActiveBackground": "#21252c",
      "tab.activeForeground": "#e6e6e6",
      "tab.unfocusedActiveForeground": "#c8ccd4",
      "tab.inactiveBackground": "#1b1e23",
      "tab.unfocusedInactiveBackground": "#1b1e23",
      "tab.inactiveForeground": "#7f848e",
      "tab.unfocusedInactiveForeground": "#5c6370",
      "tab.hoverBackground": "#1f2228",
      "tab.unfocusedHoverBackground": "#1f2228",
      "tab.hoverForeground": "#c8ccd4",
      "tab.activeBorder": "#00000000",
      "tab.activeBorderTop": "#00000000",
      "tab.unfocusedActiveBorderTop": "#00000000",
    },
    "[Kanagawa Dragon]": {
      // editor area 2 shades darker than sidebar (#1a1817) for contrast
      "editor.background": "#151413",
      "editorGutter.background": "#151413",
      "sideBar.background": "#1a1817",
      "sideBar.border": "#1a1817",
      "sideBarSectionHeader.background": "#1a1817",
      "sideBarSectionHeader.border": "#1a1817",
      "panel.background": "#1a1817",
      "panel.border": "#1a1817",
      "auxiliaryBar.background": "#1a1817",
      "titleBar.activeBackground": "#121111",
      "titleBar.inactiveBackground": "#121111",
      "titleBar.border": "#121111",
      "statusBar.background": "#121111",
      "statusBar.noFolderBackground": "#121111",
      "statusBar.border": "#121111",
      "statusBar.foreground": "#8a837c",
      "statusBarItem.remoteBackground": "#121111",
      "statusBarItem.remoteForeground": "#5fc98d",
      "commandCenter.background": "#1a1817",
      "commandCenter.activeBackground": "#2a2725",
      "commandCenter.border": "#2e2a28",
      "commandCenter.foreground": "#a69f97",
      "activityBarTop.foreground": "#c5c9c5",
      "activityBarTop.inactiveForeground": "#625e5a",
      "activityBarTop.activeBorder": "#2e8b57",
      "activityBarBadge.background": "#2e8b57",
      "activityBarBadge.foreground": "#e6e0d8",
      "badge.background": "#2e8b57",
      "badge.foreground": "#e6e0d8",
      "editorGroupHeader.tabsBackground": "#151413",
      "editorGroupHeader.tabsBorder": "#151413",
      "editorGroupHeader.border": "#151413",
      "editorGroup.border": "#121111",
      "tab.border": "#151413",
      "tab.activeBackground": "#2a2725",
      "tab.inactiveBackground": "#151413",
      "tab.hoverBackground": "#232120",
      "tab.activeForeground": "#e6e0d8",
      "tab.inactiveForeground": "#7a736c",
      "tab.activeBorder": "#00000000",
      "tab.activeBorderTop": "#00000000",
      "tab.unfocusedActiveBorderTop": "#00000000",
      "tab.modifiedBorder": "#2e8b57",
      "editor.lineHighlightBackground": "#221f1e",
      "editor.lineHighlightBorder": "#00000000",
      "editor.selectionBackground": "#2e8b5733",
      "editor.inactiveSelectionBackground": "#2e8b571a",
      "editor.wordHighlightBackground": "#ffffff0f",
      "editor.findMatchBackground": "#2e8b5755",
      "editor.findMatchHighlightBackground": "#2e8b5726",
      "editorCursor.foreground": "#5fc98d",
      "terminalCursor.foreground": "#5fc98d",
      "editorLineNumber.foreground": "#4e4945",
      "editorLineNumber.activeForeground": "#a69f97",
      "editorWidget.background": "#221f1e",
      "editorWidget.border": "#2e2a28",
      "editorSuggestWidget.background": "#221f1e",
      "editorSuggestWidget.border": "#2e2a28",
      "editorSuggestWidget.selectedBackground": "#2e8b572e",
      "editorHoverWidget.background": "#221f1e",
      "editorHoverWidget.border": "#2e2a28",
      "quickInput.background": "#221f1e",
      "quickInputList.focusBackground": "#2e8b572e",
      "list.activeSelectionBackground": "#2e8b5726",
      "list.inactiveSelectionBackground": "#2e8b5714",
      "list.hoverBackground": "#232120",
      "list.focusOutline": "#00000000",
      "list.highlightForeground": "#5fc98d",
      "input.background": "#221f1e",
      "input.border": "#2e2a28",
      "dropdown.background": "#221f1e",
      "dropdown.border": "#2e2a28",
      "focusBorder": "#2e8b5780",
      "button.background": "#2e8b57",
      "button.foreground": "#e6e0d8",
      "button.hoverBackground": "#34a065",
      "progressBar.background": "#2e8b57",
      "statusBarItem.warningBackground": "#e5c07b",
      "statusBarItem.warningForeground": "#15171b",
      "statusBarItem.errorBackground": "#e06c75",
      "statusBarItem.errorForeground": "#15171b",
      "textLink.foreground": "#6ea8fe",
      "textLink.activeForeground": "#a5c8ff",
      "scrollbarSlider.background": "#ffffff10",
      "scrollbarSlider.hoverBackground": "#ffffff1c",
      "scrollbarSlider.activeBackground": "#2e8b5766",
      "scrollbar.shadow": "#00000000",
      "widget.shadow": "#00000080",
      "menu.background": "#221f1e",
      "menu.border": "#2e2a28",
      "menu.selectionBackground": "#2e8b572e",
      "notifications.background": "#221f1e",
      "notifications.border": "#2e2a28",
    },
  },

  // ── Layout ────────────────────────────────────────────
  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "right",
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabActionLocation": "right",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "onHover",
  "workbench.list.smoothScrolling": true,
  "breadcrumbs.enabled": false,

  // ── Editor: readable type, colored structure ──────────
  "editor.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.65,
  "editor.fontLigatures": true,
  "editor.padding.top": 16,
  "editor.padding.bottom": 16,
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "line",
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.occurrencesHighlight": "singleFile",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollbar.horizontalScrollbarSize": 8,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 2,

  // ── Terminal ──────────────────────────────────────────
  "terminal.integrated.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": true,

  // ── Claude usage, always visible in status bar ────────
  "claudeUsageBar.displayMode": "both",
  "claudeUsageBar.showProgressBar": true,

  // ── Custom UI Style: fonts + rounded floating panels ──
  "custom-ui-style.font.sansSerif": "Geist, 'Inter Variable', -apple-system, sans-serif",
  "custom-ui-style.font.monospace": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
  "custom-ui-style.extensions.enable": true,
  // appends hex-swatch script to Claude chat webview (patched from backup on each reload)
  "custom-ui-style.extensions.config": {
    "anthropic.claude-code": [
      // tab icon states: idle, running (spinning), done-unseen (green dot), needs-you (amber pulse); each has a *-dim.svg variant (logo 40%, dot full color) used when the tab is not the shown tab in its group; icons in ./claude-tab-icons/
      {
        "filePath": "extension.js",
        "find": "/(function \\w+\\(\\w+,(\\w+),\\w+\\)\\{if\\(\\w+\\?\\.hasPendingPermissions\\)return\"pending\";[^}]*?)return\"plain\"\\}var (\\w+)=\\{pending:\"claude-logo-pending\\.svg\",done:\"claude-logo-done\\.svg\",plain:\"claude-logo\\.svg\"\\}/",
        "replace": "$1if($2?.state===\"running\")return\"running\";return\"plain\"}var $3={pending:\"../../../claude-tab-icons/pending.svg\",done:\"../../../claude-tab-icons/done.svg\",plain:\"../../../claude-tab-icons/idle.svg\",running:\"../../../claude-tab-icons/running.svg\",pending_dim:\"../../../claude-tab-icons/pending-dim.svg\",done_dim:\"../../../claude-tab-icons/done-dim.svg\",plain_dim:\"../../../claude-tab-icons/idle-dim.svg\",running_dim:\"../../../claude-tab-icons/running-dim.svg\"}",
      },
      // pick the *_dim icon when the tab is not shown in its group
      {
        "filePath": "extension.js",
        "find": "/(this\\.panelTab\\.iconPath=\\w+\\.Uri\\.file\\(\\w+\\.join\\(this\\.context\\.extensionPath,\"resources\",)(\\w+)\\[(\\w+)\\]\\)/",
        "replace": "$1$2[$3+(this.panelTab.visible?\"\":\"_dim\")])",
      },
      // re-evaluate the icon whenever the tab gains or loses selection
      {
        "filePath": "extension.js",
        "find": "/(onDidChangeViewState\\(\\(\\)=>\\{if\\(!\\w+&&\\w+\\.viewColumn!==void 0\\)\\w+=\\w+\\.viewColumn;)(\\w+)\\.notifyVisibilityChange\\((\\w+)\\.visible\\),/",
        "replace": "$1$2.notifyVisibilityChange($3.visible),$2.refreshTabIcon?.(),",
      },
      // webview/index.js: ONE entry only. Custom UI Style re-applies every patch to the pristine backup, so with several entries per file only the last survives.
      // This entry: (1) usage store -> window.__ccUsageHtml + "ccUsage" chip in the chat header, (2) exposes the connection that owns signOut(), (3) switch-account button on the Email row, (4) search box always open, (5) active-session count -> --cc-active for the Session manager badge, (6) hex swatches, (7) two-click sign-out confirm.
      { "filePath": "webview/index.js", "find": "/var ([\\w$]+)=([\\w$]+)\\(null\\),([\\w$]+)=\\2\\(null\\);function ([\\w$]+)\\(\\)\\{\\1\\.value=null,\\3\\.value=null\\}([\\s\\S]*?)(signOut\\(\\)\\{return this\\.sendRequest\\(\\{type:\"sign_out\"\\}\\)\\})([\\s\\S]*?)function ([\\w$]+)\\(\\{label:([\\w$]+),value:([\\w$]+)\\}\\)\\{return ([\\w$]+)\\(\"div\",\\{className:([\\w$]+)\\.accountRow,children:\\[([\\w$]+)\\(\"span\",\\{className:\\12\\.accountLabel,children:\\9\\}\\),\\13\\(\"span\",\\{className:\\12\\.accountValue,children:\\10\\}\\)\\]\\}\\)\\}([\\s\\S]*?)([\\w$]+)=([\\w$]+)===!0,\\[([\\w$]+),([\\w$]+)\\]=([\\w$]+)\\(!1\\),([\\w$]+)=!\\15\\|\\|\\17\\|\\|([\\w$]+)!==\"\"([\\s\\S]*?)([\\w$]+)=([\\w$]+)\\(([\\w$]+)\\.map\\(([\\w$]+)\\)\\),([\\w$]+)=([\\w$]+)\\.statuses\\.length\\+\\28\\.tabStates\\.length;([\\s\\S]*?)([\\w$]+)\\(([\\w$]+),\\{\\}\\),([\\w$]+)\\(\"div\",\\{className:([\\w$]+)\\.header,children:\\[!window\\.IS_FULL_EDITOR&&([\\s\\S]*)$/", "replace": "var $1=(window.__ccUsageHtml=function(v){if(!v)return\"\";var o=\"\",n=Date.now();[[\"5h\",\"Session (5 hr)\",v.five_hour],[\"7d\",\"Weekly (7 day)\",v.seven_day]].forEach(function(a){var w=a[2];if(!w||typeof w.utilization!==\"number\")return;var p=w.resetsAt&&w.resetsAt*1e3<=n?0:Math.max(0,Math.min(100,Math.round(w.utilization*100)));var l=p>=90?\"crit\":p>=80?\"warn\":\"ok\";o+='<span class=\"ccU '+l+'\" title=\"'+a[1]+': '+p+'% used\"><b>'+a[0]+'</b><i><s style=\"width:'+p+'%\"></s></i><em>'+p+'%</em></span>'});return o},$2(null)),$3=$2(null);function $4(){$1.value=null,$3.value=null}$5$6__ccReg=(window.__ccConn=this,0);$7function $8({label:$9,value:$10}){return $11(\"div\",{className:$12.accountRow,children:[$13(\"span\",{className:$12.accountLabel,children:$9}),$13(\"span\",{className:$12.accountValue,children:$10}),$9===\"Email\"&&$13(\"button\",{type:\"button\",className:\"ccSwitchAcct\",title:\"Sign out to switch account\",\"aria-label\":\"Sign out to switch account\",onClick:(e)=>window.__ccSwitch?.(e),dangerouslySetInnerHTML:{__html:'<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M14 14.252V16.3414C13.3744 16.1203 12.7013 16 12 16C8.68629 16 6 18.6863 6 22H4C4 17.5817 7.58172 14 12 14C12.6906 14 13.3608 14.0875 14 14.252ZM12 13C8.685 13 6 10.315 6 7C6 3.685 8.685 1 12 1C15.315 1 18 3.685 18 7C18 10.315 15.315 13 12 13ZM12 11C14.21 11 16 9.21 16 7C16 4.79 14.21 3 12 3C9.79 3 8 4.79 8 7C8 9.21 9.79 11 12 11ZM18.5858 17L16.7574 15.1716L18.1716 13.7574L22.4142 18L18.1716 22.2426L16.7574 20.8284L18.5858 19H15V17H18.5858Z\"/></svg>'}})]})}$14$15=$16===!0,[$17,$18]=$19(!1),$20=!0||!$15||$17||$21!==\"\"$22$23=((x)=>{try{const r=document.documentElement,n=String(x&&x.active||0);r.style.setProperty(\"--cc-active\",JSON.stringify(n));r.dataset.ccActive=n}catch{}return x})($24($25.map($26))),$27=$28.statuses.length+$28.tabStates.length;$29$30($31,{}),$32(\"div\",{className:$33.header,children:[$30(\"div\",{className:\"ccUsage\",dangerouslySetInnerHTML:{__html:window.__ccUsageHtml($1.value)}}),!window.IS_FULL_EDITOR&&$34;(()=>{if(window.__hexSw)return;window.__hexSw=1;const H=/^#[0-9a-fA-F]{3,8}/,L=[4,5,7,9];let q=0;const run=()=>{q=0;document.querySelectorAll('code').forEach(c=>{if(c.closest('pre'))return;const t=c.textContent.trim();if(c.dataset.hxt===t)return;c.dataset.hxt=t;const m=t.match(H);if(m&&m[0].length===t.length&&L.includes(t.length)){c.dataset.hx='1';c.style.setProperty('--hx',t)}else if(c.dataset.hx){delete c.dataset.hx;c.style.removeProperty('--hx')}})};new MutationObserver(()=>{if(!q)q=requestAnimationFrame(run)}).observe(document.documentElement,{childList:true,subtree:true,characterData:true});run()})();;(()=>{if(window.__ccSwitch)return;let t=0;const T='Sign out to switch account',reset=b=>{delete b.dataset.armed;b.title=T;b.setAttribute('aria-label',T)};window.__ccSwitch=e=>{const b=e.currentTarget;clearTimeout(t);if(!b.dataset.armed){b.dataset.armed='1';b.title='Click again to sign out';b.setAttribute('aria-label','Click again to sign out');t=setTimeout(()=>reset(b),3000);return}reset(b);const c=window.__ccConn;if(c)c.signOut().catch(()=>{})}})();" },
    ],
    // status bar usage: warning tint from 80% (extension default 70%) to match the panel bars; red stays at 90%
    "harshagarwal1012.claude-usage-bar": [
      { "filePath": "out/extension.js", "find": "/else if \\(maxPct >= 70\\)/", "replace": "else if (maxPct >= 80)" },
    ],
  },
  "custom-ui-style.webview.removeCSP": false,
  "custom-ui-style.stylesheet": {
    // window frame shows through the gaps between panels
    ".monaco-workbench": { "background-color": "#181825 !important" },
    ".monaco-workbench .part.editor, .monaco-workbench .part.sidebar, .monaco-workbench .part.auxiliarybar, .monaco-workbench .part.panel": {
      "clip-path": "inset(3px round 12px)",
    },
    // pill tabs
    ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab": {
      "border-radius": "8px",
      "margin": "5px 2px 0 2px",
      "height": "28px !important",
      "line-height": "28px",
    },
    ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab:first-child": {
      "margin-left": "8px",
    },
    // rounded popups + controls
    ".quick-input-widget": {
      "border-radius": "14px !important",
      "overflow": "hidden",
    },
    ".monaco-editor .suggest-widget, .monaco-editor .find-widget, .monaco-hover, .monaco-workbench .notification-toast, .monaco-workbench .notifications-center": {
      "border-radius": "10px !important",
      "overflow": "hidden",
    },
    ".monaco-menu-container, .monaco-menu .monaco-action-bar.vertical": {
      "border-radius": "10px !important",
    },
    ".monaco-button, .monaco-inputbox, .monaco-select-box, .monaco-dropdown": {
      "border-radius": "6px !important",
    },
    ".monaco-list .monaco-list-row": { "border-radius": "6px" },
    ".monaco-scrollable-element > .scrollbar > .slider": {
      "border-radius": "8px",
    },
    ".monaco-workbench .command-center .command-center-center": {
      "border-radius": "8px !important",
    },
    ".monaco-workbench .part.statusbar .statusbar-item .statusbar-item-label": {
      "border-radius": "6px",
    },
    // status bar shows ONLY the Claude Usage Bar item (session + weekly), right-aligned under editor + chat
    ".monaco-workbench .part.statusbar .statusbar-item:not([id=\"harshagarwal1012.claude-usage-bar\" i])": {
      "display": "none !important",
    },
    // panel redesign: more room around the top activity icons
    ".monaco-workbench .pane-composite-part > .header-or-footer.header": { "padding": "6px 12px 0 12px !important" },
    ".monaco-workbench .pane-composite-part > .header-or-footer.header > .composite-bar-container > .composite-bar > .monaco-action-bar .action-item.icon": { "height": "29px !important", "padding": "0 4px !important" },
  },
  // webviews (Claude chat): green replaces Claude orange; each content type gets its own color
  "custom-ui-style.webview.stylesheet": {
    "html:root": {
      "--app-claude-orange": "#2e8b57 !important",
      "--app-claude-clay-button-orange": "#24704a !important",
      "--app-link-foreground": "#6ea8fe !important",
      "--app-inline-code-foreground": "#d4bf6a !important",
      "--app-inline-code-background": "#d4bf6a1a !important",
    },
    // Claude Code logo: asterisk keeps Claude brand color (the green override above recolors it otherwise)
    "[class^=\"logo_\"] svg [fill=\"var(--app-claude-clay-button-orange)\"]": {
      "fill": "#D97757 !important",
    },
    // empty new-chat tab: Milo (ASCII cat, from ~/Desktop/Milo.svg) in Claude orange, alive: breathing, head sway following gaze, ear twitches, nose sniff + whisker flick, mouth drop, pupil dilation, look + blinks (source ~/Desktop/Milo-animated.svg, generator AZ/Tools/VS Code Theme Kit/milo). Older: settings.json.pre-milo-alive.bak / .pre-milo-anim.bak / .pre-milo.bak
    "[class^=\"container_\"]:has(> [class^=\"messageContainer_\"]) > svg": {
      "display": "none !important",
    },
    "[class^=\"container_\"]:has(> [class^=\"messageContainer_\"])::before": {
      "content": "''",
      "display": "block",
      "width": "186px",
