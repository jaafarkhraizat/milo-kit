  "custom-ui-style.webview.removeCSP": false,
  "custom-ui-style.stylesheet": {
    // window frame shows through the gaps between panels
    ".monaco-workbench": {
      "background-color": "var(--mk-gap) !important"
    },
    ".monaco-workbench .part.editor, .monaco-workbench .part.sidebar, .monaco-workbench .part.auxiliarybar, .monaco-workbench .part.panel": {
      "clip-path": "inset(3px round var(--mk-r-16))"
    },
    // pill tabs
    ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab": {
      "border-radius": "var(--mk-r-10)",
      "margin": "5px 2px 0 2px",
      "height": "28px !important",
      "line-height": "28px"
    },
    ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab:first-child": {
      "margin-left": "8px",
    },
    // rounded popups + controls
    ".quick-input-widget": {
      "border-radius": "var(--mk-r-16) !important",
      "overflow": "hidden",
      "backdrop-filter": "none !important",
      "-webkit-backdrop-filter": "none !important",
      "box-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 0 0 1px rgba(255, 255, 255, 0.07), 0 24px 48px -20px rgba(0, 0, 0, 0.7), 0 2px 6px rgba(0, 0, 0, 0.3) !important"
    },
    ".monaco-editor .suggest-widget, .monaco-editor .find-widget, .monaco-hover, .monaco-workbench .notification-toast, .monaco-workbench .notifications-center": {
      "border-radius": "var(--mk-r-12) !important",
      "overflow": "hidden",
      "backdrop-filter": "none !important",
      "-webkit-backdrop-filter": "none !important",
      "box-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 0 0 1px rgba(255, 255, 255, 0.07), 0 24px 48px -20px rgba(0, 0, 0, 0.7), 0 2px 6px rgba(0, 0, 0, 0.3) !important"
    },
    ".monaco-menu-container, .monaco-menu .monaco-action-bar.vertical": {
      "border-radius": "var(--mk-r-12) !important"
    },
    ".monaco-button, .monaco-inputbox, .monaco-select-box, .monaco-dropdown": {
      "border-radius": "var(--mk-r-8) !important"
    },
    ".monaco-list .monaco-list-row": {
      "border-radius": "var(--mk-r-8)"
    },
    ".monaco-scrollable-element > .scrollbar > .slider": {
      "border-radius": "999px"
    },
    ".monaco-workbench .command-center .command-center-center": {
      "border-radius": "var(--mk-r-10) !important"
    },
    ".monaco-workbench .part.statusbar .statusbar-item .statusbar-item-label": {
      "border-radius": "var(--mk-r-8)"
    },
    // status bar shows ONLY the Claude Usage Bar item (session + weekly), right-aligned under editor + chat
    ".monaco-workbench .part.statusbar .statusbar-item:not([id=\"harshagarwal1012.claude-usage-bar\" i])": {
      "display": "none !important",
    },
    // panel redesign: more room around the top activity icons
    ".monaco-workbench .pane-composite-part > .header-or-footer.header": {
      "padding": "4px 12px 0 12px !important"
    },
    ".monaco-workbench .pane-composite-part > .header-or-footer.header > .composite-bar-container > .composite-bar > .monaco-action-bar .action-item.icon": {
      "height": "29px !important",
      "padding": "0 4px !important"
    },
    ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab.active": { "box-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 0 0 1px rgba(255, 255, 255, 0.05)" },
    ".quick-input-widget .quick-input-header, .quick-input-widget .quick-input-list .monaco-list": { "background": "transparent !important" },
    ".quick-input-widget .monaco-inputbox": { "border-radius": "var(--mk-r-10) !important", "background-color": "rgba(255, 255, 255, 0.04) !important" },
    ".quick-input-widget .quick-input-list .monaco-list-row": {
      "border-radius": "var(--mk-r-10) !important"
    },
    ".monaco-workbench .pane-composite-part > .title > .title-label": {
      "transform": "translateY(4px)"
    },
    "div:has(> .webview-overlay-content:not([style*=\"visibility: hidden\"]) iframe[src*=\"extensionId=local.milo-kit-settings\"])": {
      "position": "fixed !important",
      "top": "0 !important",
      "left": "0 !important",
      "right": "0 !important",
      "bottom": "0 !important",
      "width": "auto !important",
      "height": "auto !important",
      "clip-path": "none !important",
      "z-index": "2550 !important"
    },
    "div:has(> .webview-overlay-content:not([style*=\"visibility: hidden\"]) iframe[src*=\"extensionId=local.milo-kit-settings\"])::before": {
      "content": "''",
      "position": "absolute",
      "inset": "0",
      "background": "rgba(8, 10, 14, 0.55)",
      "pointer-events": "auto"
    },
    ".webview-overlay-content:not([style*=\"visibility: hidden\"]):has(iframe[src*=\"extensionId=local.milo-kit-settings\"])": {
      "top": "50% !important",
      "left": "50% !important",
      "transform": "translate(-50%, -50%)",
      "width": "min(1180px, calc(100vw - 80px)) !important",
      "height": "min(820px, calc(100vh - 80px)) !important",
      "border-radius": "16px",
      "border": "1px solid rgba(255, 255, 255, 0.09)",
      "box-shadow": "0 32px 80px -24px rgba(0, 0, 0, 0.75), 0 4px 12px rgba(0, 0, 0, 0.35)",
      "z-index": "1 !important"
    },
    "body": {
      "--mk-gap": "rgb(14 16 19)",
      "--mk-r-16": "16px",
      "--mk-r-10": "10px",
      "--mk-r-12": "12px",
      "--mk-r-8": "8px"
    },
  },
  // webviews (Claude chat): green replaces Claude orange; each content type gets its own color
  "custom-ui-style.webview.stylesheet": {
    "html:root": {
      "--app-claude-orange": "var(--mk-accent) !important",
      "--app-claude-clay-button-orange": "var(--mk-accent-strong) !important",
      "--app-link-foreground": "var(--mk-link) !important",
      "--app-inline-code-foreground": "#d4bf6a !important",
      "--app-inline-code-background": "#d4bf6a1a !important",
      "--corner-radius-small": "var(--mk-r-8) !important",
      "--corner-radius-medium": "var(--mk-r-12) !important",
      "--corner-radius-large": "var(--mk-r-16) !important",
      "--app-list-border-radius": "var(--mk-r-8) !important",
      "--mk-glass": "rgba(255, 255, 255, 0.035)",
      "--mk-glass-hover": "rgba(255, 255, 255, 0.055)",
      "--mk-glass-float": "var(--app-primary-background)",
      "--mk-edge": "rgba(255, 255, 255, 0.07)",
      "--mk-edge-strong": "rgba(255, 255, 255, 0.11)",
      "--mk-hi": "inset 0 1px 0 rgba(255, 255, 255, 0.05)",
      "--mk-blur": "none",
      "--mk-shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.25), 0 6px 16px -8px rgba(0, 0, 0, 0.4)",
      "--mk-shadow-lg": "0 24px 48px -20px rgba(0, 0, 0, 0.7), 0 2px 6px rgba(0, 0, 0, 0.3)",
      "--mk-accent": "rgb(63 116 224)",
      "--mk-accent-strong": "rgb(47 90 184)",
      "--mk-accent-hover": "rgb(80 132 234)",
      "--mk-accent-soft": "rgb(130 169 245)",
      "--mk-accent-softer": "rgb(157 187 247)",
      "--mk-link": "rgb(110 168 254)",
      "--mk-fg": "rgb(236 238 242)",
      "--mk-fg-body": "rgb(200 204 212)",
      "--mk-fg-muted": "rgb(139 145 156)",
      "--mk-fg-faint": "rgb(88 93 101)",
      "--mk-card": "rgb(26 29 34)",
      "--mk-gap": "rgb(14 16 19)",
      "--mk-r-8": "8px",
      "--mk-r-12": "12px",
      "--mk-r-16": "16px",
      "--mk-r-6": "6px",
      "--mk-r-4": "4px",
      "--mk-r-10": "10px",
      "--mk-r-5": "5px",
      "--mk-r-9": "9px",
      "--mk-r-7": "7px",
      "--mk-fg-hi": "rgb(243 244 247)",
      "--mk-fg-bold": "rgb(234 236 240)",
      "--mk-fg-msg": "rgb(221 224 229)",
      "--mk-fg-2": "rgb(231 233 238)",
      "--mk-fg-3": "rgb(224 227 232)",
      "--mk-fg-4": "rgb(216 219 225)",
      "--mk-fg-5": "rgb(219 222 228)",
      "--mk-fg-6": "rgb(214 217 224)",
      "--mk-fg-7": "rgb(188 192 201)",
      "--mk-fg-8": "rgb(173 178 187)",
      "--mk-fg-9": "rgb(166 171 181)",
      "--mk-fg-10": "rgb(158 163 173)",
      "--mk-fg-11": "rgb(124 130 140)",
      "--mk-fg-12": "rgb(109 114 124)",
      "--mk-line": "rgb(71 76 83)",
      "--mk-card-hi": "rgb(45 48 54)",
      "--mk-card-hi-2": "rgb(36 39 45)",
      "--mk-card-low": "rgb(25 28 33)",
      "--mk-card-low-2": "rgb(21 23 27)",
      "--mk-accent-pale": "rgb(214 227 255)",
      "--mk-accent-pale-2": "rgb(207 224 255)",
      "--mk-link-hi": "rgb(165 200 255)",
      "--mk-link-2": "rgb(141 186 255)",
      "--mk-accent-top": "rgb(95 144 238)",
      "--mk-accent-press": "rgb(52 99 199)"
    },
    // Claude Code logo: asterisk keeps Claude brand color (the green override above recolors it otherwise)
    "[class^=\"logo_\"] svg [fill=\"var(--app-claude-clay-button-orange)\"]": {
      "fill": "#D97757 !important",
    },
    // empty new-chat tab: Milo in Claude orange, alive: breathing, head sway following gaze, ear twitches, nose sniff + whisker flick, mouth drop, pupil dilation, look + blinks.
    "[class^=\"container_\"]:has(> [class^=\"messageContainer_\"]) > svg": {
      "display": "none !important",
    },
    "[class^=\"container_\"]:has(> [class^=\"messageContainer_\"])::before": {
