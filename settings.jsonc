    ".mkQuoteBtn": {
      "position": "fixed",
      "z-index": "70",
      "display": "inline-flex",
      "align-items": "center",
      "gap": "6px",
      "height": "28px",
      "padding": "0 11px 0 9px",
      "margin": "0",
      "appearance": "none",
      "border": "1px solid var(--mk-edge-strong)",
      "border-radius": "999px",
      "background": "var(--mk-glass-float)",
      "box-shadow": "var(--mk-hi), var(--mk-shadow-sm)",
      "color": "var(--mk-fg-3)",
      "font": "500 12px/1 Geist, sans-serif",
      "white-space": "nowrap",
      "cursor": "pointer",
      "animation": "mkRise 160ms cubic-bezier(.2, .8, .2, 1)",
      "transition": "background-color 120ms cubic-bezier(.4, 0, .2, 1), color 120ms cubic-bezier(.4, 0, .2, 1)"
    },
