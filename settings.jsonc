9826C3.44694 21 3 20.5551 3 20.0066V3.9934C3 3.44476 3.44495 3 3.9934 3H20.0066C20.5552 3 21 3.44749 21 3.9985V14H15ZM21 16L16 20.997V16H21Z',\n    vercel: 'M23 21.6479H1L12 2.35205L23 21.6479Z',\n    supabase: 'M3.08378 15.25C1.42044 15.25 0.483971 13.3378 1.5038 12.0237L10.2099 0.806317C10.794 0.053716 11.9999 0.466765 11.9999 1.41944V8.74999H20.9159C22.5793 8.74999 23.5157 10.6622 22.4959 11.9762L13.7898 23.1937C13.2057 23.9463 11.9999 23.5332 11.9999 22.5805V15.25H3.08378Z',\n  };\n  const MCP_BRANDS = [\n    [/figma/i, 'figma', '#f24e1e'], [/notion/i, 'notion', '#ebebeb', '#191919'], [/chrome|browser/i, 'chrome', '#1a73e8'],\n    [/context7/i, 'book', '#0f766e'], [/claude|anthropic/i, 'claude', '#d97757'], [/microsoft|outlook|365|teams|sharepoint/i, 'microsoft', '#0078d4'],\n    [/gmail|^mail/i, 'mail', '#ea4335'], [/calendar/i, 'calendar', '#4285f4'], [/drive/i, 'drive', '#1fa463'],\n    [/docs|sheets|slides/i, 'doc', '#4285f4'], [/google/i, 'google', '#4285f4'], [/slack/i, 'slack', '#611f69'],\n    [/github/i, 'github', '#30363d'], [/cloudflare/i, 'cloud', '#f38020'], [/playwright|puppeteer|fetch/i, 'web', '#2ead33'],\n    [/^exa|search|perplexity/i, 'search', '#1f40ed'], [/memory/i, 'brain', '#7c3aed'], [/higgsfield|video/i, 'film', '#3a3f4b'],\n    [/mobbin/i, 'phone', '#3a3f4b'], [/paper|notes?/i, 'note', '#b8860b'], [/vercel/i, 'vercel', '#000000'],\n    [/supabase/i, 'supabase', '#3ecf8e', '#0b2b1c'],\n  ];\n  const MCP_MAX = 5;\n  const mcpParse = (name) => { const p = name.split('__'); return p.length >= 3 ? { id: p[1], tool: p.slice(2).join('__') } : null; };\n  const mcpLabel = (id) => { const n = id.replace(/^claude_ai_/, '').replace(/^plugin_[^_]+_/, '').replace(/[_-]+/g, ' ').trim(); return n.charAt(0).toUpperCase() + n.slice(1); };\n  const mcpHue = (t) => { let h = 0; for (let i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) % 360; return 'hsl(' + h + ', 32%, 36%)'; };\n  let mcpCache = { key: '', list: [] };\n  function mcpUsed(s) {\n    let msgs = [];\n    try { msgs = (s.messages && s.messages.value) || []; } catch (e) {}\n    const last = msgs.length ? msgs[msgs.length - 1] : null;\n    const key = msgs.length + ':' + String(last && last.uuid);\n    if (key === mcpCache.key) return mcpCache.list;\n    const servers = new Map(), ids = new Set(), seen = new Set();\n    const visit = (o, depth) => {\n      if (!o || typeof o !== 'object' || depth > 6 || seen.has(o)) return;\n      seen.add(o);\n      if (Array.isArray(o)) { o.forEach((x) => visit(x, depth + 1)); return; }\n      if (o.type === 'tool_use' && typeof o.name === 'string' && o.name.indexOf('mcp__') === 0) {\n        if (o.id && ids.has(o.id)) return;\n        if (o.id) ids.add(o.id);\n        const p = mcpParse(o.name);\n        if (!p) return;\n        let e = servers.get(p.id);\n        if (!e) servers.set(p.id, (e = { id: p.id, calls: 0, tools: new Map() }));\n        e.calls++;\n        e.tools.set(p.tool, (e.tools.get(p.tool) || 0) + 1);\n        return;\n      }\n      for (const k in o) { if (k === 'data' || k === 'text' || k === 'input' || k === 'toolResult') continue; const v = o[k]; if (v && typeof v === 'object') visit(v, depth + 1); }\n    };\n    msgs.forEach((m) => visit(m, 0));\n    mcpCache = { key, list: Array.from(servers.values()) };\n    return mcpCache.list;\n  }\n  let mcpDrawn = '';\n  function syncMcp() {\n    const s = window.__mkS;\n    const usage = q('.ccUsage');\n    const header = usage && usage.parentElement;\n    if (!s || !header) return;\n    const list = mcpUsed(s);\n    let box = q(':scope > .mkMcp', header);\n    if (!box) {\n      box = document.createElement('div');\n      box.className = 'mkMcp';\n      box.setAttribute('role', 'list');\n      box.setAttribute('aria-label', 'MCP servers used in this chat');\n    }\n    const after = q(':scope > .mkTasks', header) || usage;\n    if (box.previousElementSibling !== after) after.after(box);\n    const sig = list.map((x) => x.id + ':' + x.calls).join('|');\n    if (sig === mcpDrawn && box.isConnected) return;\n    mcpDrawn = sig;\n    box.hidden = !list.length;\n    const frag = document.createDocumentFragment();\n    const shown = list.length > MCP_MAX ? list.slice(0, MCP_MAX - 1) : list;\n    shown.forEach((sv) => {\n      const label = mcpLabel(sv.id);\n      const brand = MCP_BRANDS.find((b) => b[0].test(label));\n      const el = document.createElement('span');\n      el.className = 'mkMcpAv';\n      el.setAttribute('role', 'listitem');\n      el.style.background = brand ? brand[2] : mcpHue(label);\n      el.style.color = brand && brand[3] ? brand[3] : '#ffffff';\n      if (brand) el.innerHTML = '<svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"' + MCP_ICONS[brand[1]] + '\"/></svg>';\n      else el.textContent = label.charAt(0);\n      const tools = Array.from(sv.tools.entries()).sort((a, b) => b[1] - a[1]).map((t) => t[0].replace(/_/g, ' ') + (t[1] > 1 ? ' ×' + t[1] : ''));\n      el.title = label + ' · ' + plural(sv.calls, 'call') + '\\n' + tools.slice(0, 8).join('\\n') + (tools.length > 8 ? '\\n+' + (tools.length - 8) + ' more' : '');\n      el.setAttribute('aria-label', label + ', ' + plural(sv.calls, 'call'));\n      frag.appendChild(el);\n    });\n    if (list.length > MCP_MAX) {\n      const rest = list.slice(MCP_MAX - 1);\n      const more = document.createElement('span');\n      more.className = 'mkMcpAv mkMcpMore';\n      more.setAttribute('role', 'listitem');\n      more.textContent = '+' + rest.length;\n      more.title = rest.map((x) => mcpLabel(x.id) + ' · ' + plural(x.calls, 'call')).join('\\n');\n      more.setAttribute('aria-label', rest.length + ' more servers');\n      frag.appendChild(more);\n    }\n    box.replaceChildren(frag);\n  }\n\n  setInterval(() => { syncAgents(); syncTokens(); syncMcp(); }, 1000);\n\n  let timer = 0;\n  function schedule() { if (!timer) timer = setTimeout(() => { timer = 0; build(); syncAgents(); syncTokens(); syncMcp(); }, 200); }\n  const OWN = '.mkMap, .mkAgents, .mkTasks, .mkPanel, .mkHeld, .mkThumb, .mkMapToggle, .mkTokens, .mkMcp';\n  const isOwn = (n) => { const el = n && (n.nodeType === 1 ? n : n.parentElement); return !!(el && el.closest(OWN)); };\n  new MutationObserver((list) => {\n    if (list.every((m) => isOwn(m.target))) return;\n    schedule();\n  }).observe(document.documentElement, { childList: true, subtree: true, characterData: true });\n  window.addEventListener('resize', schedule);\n  schedule();\n})();/*/mk-chat*/"
      },
      {
        "filePath": "package.json",
        "find": "\"editor/title\": [",
        "replace": "\"editor/title/context\": [{ \"command\": \"claude-vscode.renameSessionTab\", \"when\": \"activeWebviewPanelId == 'claudeVSCodePanel'\", \"group\": \"1_claude\" }],\n\"editor/title\": ["
      }
    ],
    // status bar usage: warning tint from 80% (extension default 70%) to match the panel bars; red stays at 90%
    "harshagarwal1012.claude-usage-bar": [
      { "filePath": "out/extension.js", "find": "/else if \\(maxPct >= 70\\)/", "replace": "else if (maxPct >= 80)" },
    ],
  },
  "custom-ui-style.webview.removeCSP": false,
  "custom-ui-style.stylesheet": {
    // window frame shows through the gaps between panels
    ".monaco-workbench": {
      "background-color": "#181825 !important"
    },
    ".monaco-workbench .part.editor, .monaco-workbench .part.sidebar, .monaco-workbench .part.auxiliarybar, .monaco-workbench .part.panel": {
      "clip-path": "inset(3px round 16px)"
    },
    // pill tabs
    ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab": {
      "border-radius": "10px",
      "margin": "5px 2px 0 2px",
      "height": "28px !important",
      "line-height": "28px"
    },
    ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab:first-child": {
      "margin-left": "8px",
    },
    // rounded popups + controls
    ".quick-input-widget": {
      "border-radius": "16px !important",
      "overflow": "hidden",
      "backdrop-filter": "none !important",
      "-webkit-backdrop-filter": "none !important",
      "box-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 0 0 1px rgba(255, 255, 255, 0.07), 0 24px 48px -20px rgba(0, 0, 0, 0.7), 0 2px 6px rgba(0, 0, 0, 0.3) !important"
    },
    ".monaco-editor .suggest-widget, .monaco-editor .find-widget, .monaco-hover, .monaco-workbench .notification-toast, .monaco-workbench .notifications-center": {
      "border-radius": "12px !important",
      "overflow": "hidden",
      "backdrop-filter": "none !important",
      "-webkit-backdrop-filter": "none !important",
      "box-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 0 0 1px rgba(255, 255, 255, 0.07), 0 24px 48px -20px rgba(0, 0, 0, 0.7), 0 2px 6px rgba(0, 0, 0, 0.3) !important"
    },
    ".monaco-menu-container, .monaco-menu .monaco-action-bar.vertical": {
      "border-radius": "12px !important"
    },
    ".monaco-button, .monaco-inputbox, .monaco-select-box, .monaco-dropdown": {
      "border-radius": "8px !important"
    },
    ".monaco-list .monaco-list-row": {
      "border-radius": "8px"
    },
    ".monaco-scrollable-element > .scrollbar > .slider": {
      "border-radius": "999px"
    },
    ".monaco-workbench .command-center .command-center-center": {
      "border-radius": "10px !important"
    },
    ".monaco-workbench .part.statusbar .statusbar-item .statusbar-item-label": {
      "border-radius": "8px"
    },
    // status bar shows ONLY the Claude Usage Bar item (session + weekly), right-aligned under editor + chat
    ".monaco-workbench .part.statusbar .statusbar-item:not([id=\"harshagarwal1012.claude-usage-bar\" i])": {
      "display": "none !important",
    },
    // panel redesign: more room around the top activity icons
    ".monaco-workbench .pane-composite-part > .header-or-footer.header": {
      "padding": "4px 12px 0 12px !important"
    },
    ".monaco-workbench .pane-composite-part > .header-or-footer.header > .composite-bar-container > .composite-bar > .monaco-action-bar .action-item.icon": {
      "height": "29px !important",
      "padding": "0 4px !important"
    },
    ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab.active": { "box-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 0 0 1px rgba(255, 255, 255, 0.05)" },
    ".quick-input-widget .quick-input-header, .quick-input-widget .quick-input-list .monaco-list": { "background": "transparent !important" },
    ".quick-input-widget .monaco-inputbox": { "border-radius": "10px !important", "background-color": "rgba(255, 255, 255, 0.04) !important" },
    ".quick-input-widget .quick-input-list .monaco-list-row": {
      "border-radius": "10px !important"
    },
    ".monaco-workbench .pane-composite-part > .title > .title-label": {
      "transform": "translateY(4px)"
    },
  },
  // webviews (Claude chat): green replaces Claude orange; each content type gets its own color
  "custom-ui-style.webview.stylesheet": {
    "html:root": {
      "--app-claude-orange": "#3f74e0 !important",
      "--app-claude-clay-button-orange": "#2f5ab8 !important",
      "--app-link-foreground": "#6ea8fe !important",
      "--app-inline-code-foreground": "#d4bf6a !important",
      "--app-inline-code-background": "#d4bf6a1a !important",
      "--corner-radius-small": "8px !important",
      "--corner-radius-medium": "12px !important",
      "--corner-radius-large": "16px !important",
      "--app-list-border-radius": "8px !important",
      "--mk-glass": "rgba(255, 255, 255, 0.035)",
      "--mk-glass-hover": "rgba(255, 255, 255, 0.055)",
      "--mk-glass-float": "var(--app-primary-background)",
      "--mk-edge": "rgba(255, 255, 255, 0.07)",
      "--mk-edge-strong": "rgba(255, 255, 255, 0.11)",
      "--mk-hi": "inset 0 1px 0 rgba(255, 255, 255, 0.05)",
      "--mk-blur": "none",
      "--mk-shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.25), 0 6px 16px -8px rgba(0, 0, 0, 0.4)",
      "--mk-shadow-lg": "0 24px 48px -20px rgba(0, 0, 0, 0.7), 0 2px 6px rgba(0, 0, 0, 0.3)"
    },
    // Claude Code logo: asterisk keeps Claude brand color (the green override above recolors it otherwise)
    "[class^=\"logo_\"] svg [fill=\"var(--app-claude-clay-button-orange)\"]": {
      "fill": "#D97757 !important",
    },
    // empty new-chat tab: Milo in Claude orange, alive: breathing, head sway following gaze, ear twitches, nose sniff + whisker flick, mouth drop, pupil dilation, look + blinks.
    "[class^=\"container_\"]:has(> [class^=\"messageContainer_\"]) > svg": {
      "display": "none !important",
    },
    "[class^=\"container_\"]:has(> [class^=\"messageContainer_\"])::before": {
      "content": "''",
      "display": "block",
