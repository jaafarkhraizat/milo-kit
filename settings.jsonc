    },
    "[data-mk-md][data-mk-bubble][data-mk-forming]": {
      "background-color": "transparent",
      "box-shadow": "inset 0 0 0 1px rgba(217, 119, 87, 0)"
    },
    ".mkQuoteBtn[data-kind=\"file\"] > i": {
      "-webkit-mask": "url(\"data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22currentColor%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M21%208V20.9932C21%2021.5501%2020.5552%2022%2020.0066%2022H3.9934C3.44495%2022%203%2021.556%203%2021.0082V2.9918C3%202.45531%203.4487%202%204.00221%202H14.9968L21%208ZM19%209H14V4H5V20H19V9Z%22%2F%3E%3C%2Fsvg%3E\") center / contain no-repeat",
