    },
    ".mkReply[data-solo]": {
      "position": "absolute",
      "right": "calc(var(--mk-ub-r, 0px) + 8px)",
      "bottom": "calc(var(--mk-ub-b, 0px) + 8px)",
      "z-index": "1",
      "width": "27px",
      "height": "28px",
      "padding": "0",
      "margin": "0",
      "display": "grid",
      "place-items": "center",
      "appearance": "none",
      "border": "0",
      "border-radius": "var(--mk-r-9)",
      "cursor": "pointer",
      "color": "var(--mk-fg-10)",
      "background": "color-mix(in srgb, #fff 4%, var(--app-primary-background, var(--mk-card)))",
      "box-shadow": "inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 6px 16px -6px rgba(0, 0, 0, 0.55)",
      "opacity": "0",
      "transition": "opacity 120ms cubic-bezier(.4, 0, .2, 1), color 120ms cubic-bezier(.4, 0, .2, 1)"
    },
    ".mkReply[data-solo]:hover": {
      "color": "var(--mk-fg)"
    },
    ".mkReply[data-solo]:focus-visible": {
      "outline": "none",
      "box-shadow": "0 0 0 2px color-mix(in srgb, var(--mk-accent-soft) 50%, transparent)"
    },
    ".mkReply[data-solo]::before": {
