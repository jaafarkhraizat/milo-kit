    "[data-mk-md] [class*=\"insightFooter_\"]": {
      "opacity": "0.3"
    },
    "[data-mk-skill]": {
      "display": "inline-flex",
      "align-items": "center",
      "gap": "4px",
      "color": "#f7bd84 !important",
      "font-weight": "700 !important"
    },
    "[data-mk-skill]::before": {
      "content": "''",
      "width": "12px",
      "height": "12px",
      "background": "#f59f4c",
      "-webkit-mask": "url(\"data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22currentColor%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M13%2010H20L11%2023V14H4L13%201V10Z%22%2F%3E%3C%2Fsvg%3E\") center / contain no-repeat",
      "mask": "url(\"data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22currentColor%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M13%2010H20L11%2023V14H4L13%201V10Z%22%2F%3E%3C%2Fsvg%3E\") center / contain no-repeat"
    },
    "[data-mk-skill] + *": {
      "color": "#f7bd84 !important",
      "font-weight": "600"
    },
    ".mkUsage": {
      "position": "fixed",
      "z-index": "70",
      "overflow": "auto",
      "overscroll-behavior": "contain",
      "box-sizing": "border-box",
      "border-radius": "var(--mk-r-16)",
      "background": "var(--mk-glass-float)",
      "border": "1px solid var(--mk-edge-strong)",
      "box-shadow": "var(--mk-hi), var(--mk-shadow-lg)",
      "color": "var(--mk-fg-body)",
      "font": "12px/1.45 Geist, sans-serif",
      "animation": "mkRise 240ms cubic-bezier(.2, .8, .2, 1)",
      "scrollbar-width": "thin"
    },
    ".mkUsage[hidden], .mkUTip[hidden]": {
      "display": "none !important"
    },
    ".mkUsage button": {
      "font-family": "inherit"
    },
    ".mkUsage button:focus-visible": {
      "outline": "none",
      "box-shadow": "0 0 0 2px color-mix(in srgb, var(--mk-accent-soft) 50%, transparent)"
    },
    ".mkUsage b": {
      "font-weight": "500"
    },
    ".mkUHead": {
      "position": "sticky",
      "top": "0",
      "z-index": "3",
      "display": "flex",
      "align-items": "center",
      "gap": "10px",
      "padding": "14px 12px 12px 16px",
      "background": "var(--mk-glass-float)",
      "border-bottom": "1px solid rgba(255, 255, 255, 0.06)"
    },
    ".mkUHead > div:first-child": {
      "flex": "1",
      "min-width": "0",
      "display": "flex",
      "flex-direction": "column",
      "gap": "2px"
    },
    ".mkUHead > div:first-child > *": {
      "overflow": "hidden",
      "text-overflow": "ellipsis",
      "white-space": "nowrap"
    },
    ".mkUHead strong": {
      "font-size": "14px",
      "font-weight": "600",
      "color": "var(--mk-fg)",
      "letter-spacing": "-0.01em"
    },
    ".mkUHead small": {
      "font-size": "11px",
      "color": "var(--mk-fg-12)"
    },
    ".mkUSeg": {
      "flex": "none",
      "display": "inline-flex",
      "gap": "2px",
      "padding": "2px",
      "border-radius": "var(--mk-r-10)",
      "background": "rgba(255, 255, 255, 0.04)",
      "box-shadow": "inset 0 0 0 1px var(--mk-edge)"
    },
    ".mkUSeg button": {
      "appearance": "none",
      "border": "0",
      "height": "24px",
      "min-width": "30px",
      "padding": "0 7px",
      "border-radius": "var(--mk-r-8)",
      "background": "transparent",
      "color": "var(--mk-fg-muted)",
      "font": "500 11px/24px 'Geist Mono', 'JetBrains Mono', Menlo, monospace",
      "cursor": "pointer",
      "transition": "background 120ms cubic-bezier(.4, 0, .2, 1), color 120ms cubic-bezier(.4, 0, .2, 1)"
    },
    ".mkUSeg button:hover": {
      "color": "var(--mk-fg-3)",
      "background": "var(--mk-glass-hover)"
    },
    ".mkUSeg button[aria-selected=\"true\"]": {
      "color": "var(--mk-accent-pale)",
      "background": "color-mix(in srgb, var(--mk-accent) 22%, transparent)",
      "box-shadow": "inset 0 0 0 1px color-mix(in srgb, var(--mk-accent-soft) 28%, transparent)"
    },
    ".mkUClose": {
      "flex": "none",
      "appearance": "none",
      "border": "0",
      "display": "grid",
      "place-items": "center",
      "width": "28px",
      "height": "28px",
      "padding": "0",
      "border-radius": "var(--mk-r-8)",
      "background": "transparent",
      "color": "var(--mk-fg-muted)",
      "cursor": "pointer",
      "transition": "background 120ms, color 120ms"
    },
    ".mkUClose:hover": {
      "background": "var(--mk-glass-hover)",
      "color": "var(--mk-fg)"
    },
    ".mkUBody": {
      "position": "relative",
      "display": "flex",
      "flex-direction": "column",
      "gap": "10px",
      "padding": "12px"
    },
    ".mkUEmpty": {
      "margin": "0",
      "padding": "32px 20px 36px",
      "text-align": "center",
      "color": "var(--mk-fg-muted)",
      "line-height": "1.55"
    },
    ".mkUKpis": {
      "display": "grid",
      "grid-template-columns": "repeat(auto-fit, minmax(138px, 1fr))",
      "gap": "8px"
    },
    ".mkUKpi": {
      "border-radius": "var(--mk-r-12)",
      "background": "rgba(255, 255, 255, 0.035)",
      "border": "1px solid var(--mk-edge)",
      "display": "flex",
      "flex-direction": "column",
      "gap": "6px",
      "min-width": "0",
      "padding": "12px 14px",
      "box-shadow": "var(--mk-hi)"
    },
    ".mkUKpi > span": {
      "font": "500 10.5px/1.2 Geist, sans-serif",
      "letter-spacing": "0.06em",
      "text-transform": "uppercase",
      "color": "var(--mk-fg-12)"
    },
    ".mkUKpiV": {
      "display": "flex",
      "align-items": "center",
      "gap": "8px",
      "min-width": "0"
    },
    ".mkUKpiV > b": {
      "font": "500 22px/1.1 Geist, sans-serif",
      "letter-spacing": "-0.02em",
      "color": "var(--mk-fg-hi)",
      "font-variant-numeric": "tabular-nums"
    },
    ".mkUKpi > small": {
      "display": "flex",
      "align-items": "center",
      "gap": "6px",
      "min-width": "0",
      "font-size": "11px",
      "color": "var(--mk-fg-muted)",
      "white-space": "nowrap",
      "overflow": "hidden",
      "text-overflow": "ellipsis"
    },
    ".mkUD": {
      "flex": "none",
      "font": "500 10.5px/16px 'Geist Mono', 'JetBrains Mono', Menlo, monospace",
      "font-style": "normal",
      "padding": "0 5px",
      "border-radius": "999px",
      "background": "rgba(255, 255, 255, 0.06)",
      "color": "var(--mk-fg-10)"
    },
    ".mkUD[data-t=\"good\"]": {
      "background": "rgba(152, 195, 121, 0.14)",
      "color": "#a8d08d"
    },
    ".mkUD[data-t=\"bad\"]": {
      "background": "rgba(224, 108, 117, 0.15)",
      "color": "#ef8a92"
    },
    ".mkUCard": {
      "border-radius": "var(--mk-r-12)",
      "background": "rgba(255, 255, 255, 0.025)",
      "border": "1px solid var(--mk-edge)",
      "min-width": "0",
      "padding": "12px 14px 14px"
    },
    ".mkUCard h4": {
      "font": "500 10.5px/1.2 Geist, sans-serif",
      "letter-spacing": "0.06em",
      "text-transform": "uppercase",
      "color": "var(--mk-fg-12)",
      "display": "flex",
      "align-items": "center",
      "justify-content": "space-between",
      "gap": "8px",
      "margin": "0 0 10px"
    },
    ".mkUCard h4 small": {
      "font": "500 10.5px/1 'Geist Mono', 'JetBrains Mono', Menlo, monospace",
      "letter-spacing": "0",
      "color": "var(--mk-fg-faint)"
    },
    ".mkULegend": {
      "display": "inline-flex",
      "align-items": "center",
      "gap": "6px",
      "font": "400 11px/1 Geist, sans-serif",
      "letter-spacing": "0",
      "text-transform": "none",
      "color": "var(--mk-fg-muted)"
    },
    ".mkULegend i": {
      "display": "inline-block",
      "width": "8px",
      "height": "8px",
      "border-radius": "2px",
      "margin-left": "6px"
    },
    ".mkUsage i.ok": {
      "background": "#5b8def"
    },
    ".mkUsage i.re": {
      "background": "#b8812c"
    },
    ".mkUSplit": {
      "display": "grid",
      "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
      "gap": "10px"
    },
    ".mkUChart": {
      "position": "relative",
      "padding-right": "40px"
    },
    ".mkUGrid": {
      "position": "absolute",
      "top": "0",
      "left": "0",
      "right": "0",
      "height": "128px",
      "display": "flex",
      "flex-direction": "column",
      "justify-content": "space-between",
      "pointer-events": "none"
    },
    ".mkUGrid > span": {
      "position": "relative",
      "height": "0",
      "border-top": "1px dashed rgba(255, 255, 255, 0.07)"
    },
    ".mkUGrid > span:last-child": {
      "border-top-style": "solid",
      "border-top-color": "rgba(255, 255, 255, 0.12)"
    },
    ".mkUGrid > span::after": {
      "content": "attr(data-v)",
      "position": "absolute",
      "right": "0",
      "top": "-6px",
      "font": "400 10px/1 'Geist Mono', 'JetBrains Mono', Menlo, monospace",
      "color": "var(--mk-fg-faint)"
    },
    ".mkUBars": {
      "position": "relative",
      "height": "128px",
      "display": "flex",
      "align-items": "stretch",
      "justify-content": "space-between",
      "gap": "clamp(1px, calc(160px / var(--n)), 8px)"
    },
    ".mkUBar": {
      "position": "relative",
      "flex": "1 1 0",
      "max-width": "24px",
      "display": "flex",
      "flex-direction": "column",
      "justify-content": "flex-end",
      "gap": "2px"
    },
    ".mkUBar::before": {
      "content": "''",
      "position": "absolute",
      "top": "0",
      "bottom": "0",
      "left": "-3px",
      "right": "-3px",
      "border-radius": "var(--mk-r-4)",
      "transition": "background 120ms"
    },
    ".mkUBar[data-on]::before": {
      "background": "rgba(255, 255, 255, 0.05)"
    },
    ".mkUBar > i": {
      "position": "relative",
      "display": "block",
      "min-height": "2px",
      "border-radius": "0"
    },
    ".mkUBar > i:first-child": {
      "border-radius": "var(--mk-r-4) var(--mk-r-4) 0 0"
    },
    ".mkUX": {
      "display": "flex",
      "justify-content": "space-between",
      "margin-top": "8px",
      "font": "400 10px/1 'Geist Mono', 'JetBrains Mono', Menlo, monospace",
      "color": "var(--mk-fg-faint)"
    },
    ".mkUTip": {
      "position": "absolute",
      "z-index": "5",
      "min-width": "160px",
      "box-sizing": "border-box",
      "padding": "8px 10px",
      "border-radius": "var(--mk-r-10)",
      "background": "var(--mk-card-low)",
      "border": "1px solid var(--mk-edge-strong)",
      "box-shadow": "var(--mk-shadow-lg)",
      "pointer-events": "none",
      "font": "11px/1.6 Geist, sans-serif",
      "color": "var(--mk-fg-body)",
      "animation": "mkFade 120ms cubic-bezier(.4, 0, .2, 1)"
    },
    ".mkUTip strong": {
      "display": "block",
      "margin-bottom": "4px",
      "font-size": "11.5px",
      "font-weight": "600",
      "color": "var(--mk-fg)"
    },
    ".mkUTip div": {
      "display": "flex",
      "align-items": "center",
      "gap": "6px"
    },
    ".mkUTip div span": {
      "flex": "1",
      "color": "var(--mk-fg-muted)"
    },
    ".mkUTip div b": {
      "font-family": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
      "color": "var(--mk-fg-3)",
      "font-variant-numeric": "tabular-nums"
    },
    ".mkUTip i": {
      "width": "7px",
      "height": "7px",
      "border-radius": "2px"
    },
    ".mkUInsights ul": {
      "list-style": "none",
      "margin": "0",
      "padding": "0",
      "display": "flex",
      "flex-direction": "column",
      "gap": "6px"
    },
    ".mkUInsights li": {
      "position": "relative",
      "padding": "8px 10px 8px 26px",
      "border-radius": "var(--mk-r-8)",
      "background": "rgba(255, 255, 255, 0.03)",
      "color": "var(--mk-fg-body)",
      "line-height": "1.5"
    },
    ".mkUInsights li::before": {
      "content": "''",
      "position": "absolute",
      "left": "11px",
      "top": "14px",
      "width": "6px",
      "height": "6px",
      "border-radius": "50%",
      "background": "var(--mk-accent-soft)"
    },
    ".mkUInsights li[data-t=\"warn\"]::before": {
      "background": "#e5c07b"
    },
    ".mkUInsights li[data-t=\"tip\"]::before": {
      "background": "#98c379"
    },
    ".mkUInsights li b": {
      "color": "var(--mk-fg)",
      "font-weight": "600"
    },
    ".mkUList": {
      "list-style": "none",
      "margin": "0 -8px",
      "padding": "0",
      "display": "flex",
      "flex-direction": "column",
      "gap": "2px"
    },
    ".mkUList li": {
      "display": "flex",
      "align-items": "flex-start",
      "gap": "10px",
      "padding": "7px 8px",
      "border-radius": "var(--mk-r-8)",
      "transition": "background 120ms"
    },
    ".mkUList li:hover": {
      "background": "var(--mk-glass-hover)"
    },
    ".mkUIco": {
      "flex": "none",
      "display": "grid",
      "place-items": "center",
      "width": "26px",
      "height": "26px",
      "margin-top": "1px",
      "border-radius": "var(--mk-r-8)",
      "background": "rgba(255, 255, 255, 0.05)",
      "color": "var(--mk-fg-10)",
      "box-shadow": "inset 0 0 0 1px rgba(255, 255, 255, 0.06)"
    },
    ".mkURow": {
      "flex": "1",
      "min-width": "0",
      "display": "flex",
      "flex-direction": "column",
      "gap": "5px"
    },
    ".mkURowTop": {
      "display": "flex",
      "align-items": "baseline",
      "justify-content": "space-between",
      "gap": "10px"
    },
    ".mkURowTop > span": {
      "min-width": "0",
      "overflow": "hidden",
      "text-overflow": "ellipsis",
      "white-space": "nowrap",
      "font-size": "12.5px",
      "font-weight": "500",
      "color": "var(--mk-fg-3)"
    },
    ".mkURowTop > b": {
      "flex": "none",
      "font": "500 12px/1 'Geist Mono', 'JetBrains Mono', Menlo, monospace",
      "color": "var(--mk-fg)",
      "font-variant-numeric": "tabular-nums"
    },
    ".mkUMeter": {
      "display": "flex",
      "gap": "2px",
      "height": "4px",
      "border-radius": "999px",
      "background": "rgba(255, 255, 255, 0.06)",
      "overflow": "hidden"
    },
    ".mkUMeter > i": {
      "display": "block",
      "height": "100%",
      "border-radius": "999px",
      "transition": "width 320ms cubic-bezier(.4, 0, .2, 1)"
    },
    ".mkURowSub": {
      "display": "flex",
      "align-items": "center",
      "justify-content": "space-between",
      "gap": "8px",
      "font-size": "11px",
      "color": "var(--mk-fg-11)"
    },
    ".mkURowSub > span": {
      "min-width": "0",
      "overflow": "hidden",
      "text-overflow": "ellipsis",
      "white-space": "nowrap"
    },
    ".mkURowSub > em": {
      "flex": "none",
      "font": "500 10.5px/16px 'Geist Mono', 'JetBrains Mono', Menlo, monospace",
      "font-style": "normal",
      "padding": "0 6px",
      "border-radius": "999px",
      "background": "rgba(255, 255, 255, 0.05)",
      "color": "var(--mk-fg-10)"
    },
    ".mkURowSub > em[data-t=\"warn\"]": {
      "background": "rgba(184, 129, 44, 0.16)",
      "color": "#e0b46a"
    },
    ".mkURowSub > em[data-t=\"bad\"]": {
      "background": "rgba(224, 108, 117, 0.15)",
      "color": "#ef8a92"
    },
    ".mkUMore": {
      "margin": "6px 0 0",
      "font-size": "11px",
      "color": "var(--mk-fg-12)"
    },
    ".mkUFriction": {
      "display": "grid",
      "grid-template-columns": "repeat(auto-fit, minmax(76px, 1fr))",
      "gap": "6px"
    },
    ".mkUFriction > div": {
      "display": "flex",
      "flex-direction": "column",
      "gap": "2px",
      "padding": "8px 10px",
      "border-radius": "var(--mk-r-8)",
      "background": "rgba(255, 255, 255, 0.03)"
    },
    ".mkUFriction b": {
      "font": "500 16px/1.2 Geist, sans-serif",
      "color": "var(--mk-fg)",
      "font-variant-numeric": "tabular-nums"
    },
    ".mkUFriction span": {
      "font-size": "10.5px",
      "color": "var(--mk-fg-11)"
    },
    ".mkUNote": {
      "margin": "10px 0 0",
      "font-size": "11px",
      "line-height": "1.5",
      "color": "var(--mk-fg-11)"
    },
    ".mkUFoot": {
      "margin": "2px 2px 0",
      "font-size": "10.5px",
      "line-height": "1.5",
      "color": "var(--mk-fg-faint)"
    },
    "[data-mk-md]": {
      "line-height": "1.62",
      "letter-spacing": "0.006em",
      "font-kerning": "normal",
      "transition": "padding 180ms cubic-bezier(.4, 0, .2, 1), background-color 240ms cubic-bezier(.4, 0, .2, 1), box-shadow 240ms cubic-bezier(.4, 0, .2, 1)"
    },
    "[data-mk-md] :is(p, ul, ol, h1, h2, h3, h4, h5, h6, blockquote)": {
      "max-width": "72ch"
    },
    "[data-mk-md] :is(p, li)": {
      "text-wrap": "pretty"
    },
    "[data-mk-md] :is(h1, h2, h3, h4)": {
      "text-wrap": "balance",
      "line-height": "1.3"
    },
    "[data-mk-md] :is(p, ul, ol, blockquote, table):last-child": {
      "margin-bottom": "0"
    },
    "[data-mk-md] li > :is(ul, ol)": {
      "margin": "0.2em 0 0.3em"
    },
    "[data-mk-md] li > p": {
      "margin-bottom": "0.3em"
    },
    "[data-mk-md] blockquote[data-mk-callout] > p": {
      "margin-bottom": "0.5em"
    },
    ".mkTokens > svg": {
      "display": "block",
      "flex": "none",
      "color": "#e5c07b"
    },
    ".mkTokens > b": {
      "font-weight": "500"
    },
    ".mkTokens[hidden]": {
      "display": "none !important"
    },
    ".mkTokens[hidden] + *": {
      "margin-left": "auto"
    },
    ".mkDashBtn": {
      "display": "inline-grid",
      "place-items": "center",
      "flex": "none",
      "width": "28px",
      "height": "28px",
      "padding": "0",
      "margin": "0",
      "appearance": "none",
      "border": "0",
      "border-radius": "var(--mk-r-8)",
      "background": "transparent",
      "color": "var(--app-secondary-foreground)",
      "cursor": "pointer",
      "outline": "none",
      "transition": "background 120ms cubic-bezier(.4, 0, .2, 1), color 120ms cubic-bezier(.4, 0, .2, 1)"
    },
    ".mkDashBtn > svg": {
      "display": "block",
      "width": "16px",
      "height": "16px"
    },
    "[class*=\"sectionHeader_\"] > .mkDashBtn": {
      "margin-left": "auto"
    },
    "[class*=\"sectionHeader_\"] > .mkDashBtn + [class*=\"sectionLink_\"]": {
      "margin-left": "2px !important"
    },
    ".mkDashBtn:hover": {
      "background": "var(--app-ghost-button-hover-background)",
      "color": "var(--app-primary-foreground)"
    },
    ".mkDashBtn:focus:not(:focus-visible):not(:hover)": {
      "background": "transparent",
      "color": "var(--app-secondary-foreground)"
    },
    ".mkDashBtn:focus-visible": {
      "box-shadow": "0 0 0 2px color-mix(in srgb, var(--mk-accent-soft) 50%, transparent)"
    },
    ".mkDashBtn[aria-pressed=\"true\"]": {
      "color": "var(--mk-accent-soft) !important",
      "background": "color-mix(in srgb, var(--mk-accent) 16%, transparent) !important"
    },
    ".mkUExpand": {
      "flex": "none",
      "appearance": "none",
      "border": "0",
      "display": "grid",
      "place-items": "center",
      "width": "28px",
      "height": "28px",
      "padding": "0",
      "margin-right": "-6px",
      "border-radius": "var(--mk-r-8)",
      "background": "transparent",
      "color": "var(--mk-fg-muted)",
      "cursor": "pointer",
      "transition": "background 120ms, color 120ms"
    },
    ".mkUExpand:hover": {
      "background": "var(--mk-glass-hover)",
      "color": "var(--mk-fg)"
    },
    ".mkUsage[data-page]": {
      "inset": "0",
      "width": "auto",
      "max-height": "none",
      "z-index": "80",
      "border": "0",
      "border-radius": "0",
      "box-shadow": "none",
      "background": "var(--app-primary-background, var(--mk-card))",
      "animation": "mkFade 180ms cubic-bezier(.2, .8, .2, 1)"
    },
    ".mkUsage[data-page] .mkUHead": {
      "background": "var(--app-primary-background, var(--mk-card))",
      "padding": "14px max(16px, calc((100% - 1040px) / 2 + 20px)) 14px max(20px, calc((100% - 1040px) / 2 + 24px))"
    },
    ".mkUsage[data-page] .mkUHead strong": {
      "font-size": "16px"
    },
    ".mkUsage[data-page] .mkUBody, .mkUsage[data-page] > .mkUEmpty": {
      "box-sizing": "border-box",
      "max-width": "1040px",
      "margin": "0 auto",
      "padding": "20px 20px 40px",
      "gap": "14px"
    },
    ".mkUsage[data-page] .mkUKpis": {
      "grid-template-columns": "repeat(auto-fit, minmax(170px, 1fr))",
      "gap": "10px"
    },
    ".mkUsage[data-page] .mkUSplit": {
      "grid-template-columns": "repeat(auto-fit, minmax(340px, 1fr))",
      "gap": "14px"
    },
    "[data-mk-md][data-mk-bubble]": {
      "display": "block",
      "width": "fit-content",
      "max-width": "100%",
      "box-sizing": "border-box",
      "padding": "12px 16px 13px",
      "border-radius": "var(--mk-r-16) var(--mk-r-16) var(--mk-r-16) var(--mk-r-6)",
      "background": "color-mix(in srgb, #d97757 5.5%, var(--app-primary-background, var(--mk-card)))",
      "box-shadow": "inset 0 0 0 1px rgba(217, 119, 87, 0.15)"
    },
    "[data-mk-bubble-row]": {
      "width": "fit-content",
      "max-width": "100%",
      "box-sizing": "border-box",
      "padding-bottom": "8px !important",
      "display": "grid !important",
      "grid-template-columns": "minmax(0, auto) 0",
      "align-items": "start",
      "justify-items": "start"
    },
    "[data-mk-bubble-row][class*=\"timelineMessage_\"]:not(:has(+ [class*=\"timelineMessage_\"]))::before": {
      "top": "auto !important",
      "bottom": "var(--mk-av-bottom, 8px) !important"
    },
    "[data-mk-bubble-row] > [data-message-actions]": {
      "grid-column": "2",
      "grid-row": "1 / span 40",
      "justify-self": "end",
      "align-self": "end",
      "position": "relative",
      "z-index": "1",
      "height": "auto",
      "transform": "translateY(var(--mk-act-y, 0px))",
      "display": "flex",
      "align-items": "center",
      "gap": "0",
      "margin": "0 8px 0 0",
      "padding": "2px",
      "border-radius": "var(--mk-r-9)",
      "background": "color-mix(in srgb, #d97757 5.5%, color-mix(in srgb, #fff 4%, var(--app-primary-background, var(--mk-card))))",
      "box-shadow": "inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 6px 16px -6px rgba(0, 0, 0, 0.55)",
      "opacity": "0",
      "transition": "opacity 120ms cubic-bezier(.4, 0, .2, 1)"
    },
    "[data-mk-bubble-row] > [data-message-actions] > button": {
      "width": "23px",
      "height": "24px",
      "min-width": "0",
      "padding": "0",
      "margin": "0",
      "display": "grid",
      "place-items": "center",
      "border": "0 !important",
      "border-radius": "var(--mk-r-7)",
      "background": "transparent !important",
      "box-shadow": "none",
      "opacity": "1 !important",
      "color": "var(--mk-fg-12)",
      "cursor": "pointer",
      "transition": "background-color 120ms cubic-bezier(.4, 0, .2, 1), color 120ms cubic-bezier(.4, 0, .2, 1)"
    },
    "[data-mk-bubble-row]:hover > [data-message-actions] > button": {
      "color": "var(--mk-fg-10)"
    },
    "[data-mk-bubble-row] > [data-message-actions] > button:hover": {
      "background": "rgba(255, 255, 255, 0.07) !important",
      "color": "var(--mk-fg)"
    },
    "[data-mk-bubble-row] > [data-message-actions] > button:focus-visible": {
      "outline": "none",
      "box-shadow": "0 0 0 2px color-mix(in srgb, var(--mk-accent-soft) 50%, transparent)"
    },
    "[data-mk-bubble-row] > [data-message-actions] > :is(button[aria-label^=\"Copy\"], [class*=\"bookmarkButton_\"]) > svg": {
      "display": "none"
    },
    "[data-mk-bubble-row] > [data-message-actions] > :is(button[aria-label^=\"Copy\"], [class*=\"bookmarkButton_\"])::before": {
      "content": "''",
      "width": "15px",
      "height": "15px",
      "background": "currentColor"
    },
