  // ── Layout ────────────────────────────────────────────
  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "right",
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabActionLocation": "right",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "onHover",
  "workbench.list.smoothScrolling": true,
  "workbench.hover.delay": 1200,
  "breadcrumbs.enabled": false,

  // ── Editor: readable type, colored structure ──────────
  "editor.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.65,
  "editor.fontLigatures": true,
  "editor.padding.top": 16,
  "editor.padding.bottom": 16,
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "line",
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.occurrencesHighlight": "singleFile",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollbar.horizontalScrollbarSize": 8,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 2,

  // ── Terminal ──────────────────────────────────────────
  "terminal.integrated.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": true,

  // ── Claude usage, always visible in status bar ────────
  "claudeUsageBar.displayMode": "both",
  "claudeUsageBar.showProgressBar": true,

  // ── Custom UI Style: fonts + rounded floating panels ──
